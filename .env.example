# Environment Variables for Algorythmos (Astro)
# Client-exposed vars MUST be prefixed PUBLIC_ ; everything else is server-only.

# --- Search engine verification (PUBLIC: rendered as <meta> via SEO/BaseLayout) ---
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_VERIFICATION=
PUBLIC_YANDEX_VERIFICATION=

# --- Google Sign-In (PUBLIC client id; only needed if/when the auth island is enabled) ---
PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Contact form: server-only EmailJS creds for /api/contact (never PUBLIC) ---
# Get the private key from EmailJS dashboard > Account > API Keys.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# --- Newsletter (server-only, if wired) ---
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
