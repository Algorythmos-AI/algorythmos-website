# Environment Variables for Algorythmos (Astro)
# Client-exposed vars MUST be prefixed PUBLIC_ ; everything else is server-only.

# --- Search engine verification (PUBLIC: rendered as <meta> via BaseLayout) ---
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_VERIFICATION=
PUBLIC_YANDEX_VERIFICATION=

# --- Google Sign-In (PUBLIC client id; only if/when an auth island is enabled) ---
PUBLIC_GOOGLE_CLIENT_ID=

# --- Contact form: open-source Nodemailer → your Zoho Mail SMTP (server-only) ---
# Your Zoho account is on the .com.au datacenter (mailadmin.zoho.com.au).
# 1) Create/choose a mailbox (e.g. noreply@algorythmos.com)
# 2) Zoho Mail → Settings → Security → App Passwords → generate one for SMTP
ZOHO_SMTP_HOST=smtp.zoho.com.au
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=noreply@algorythmos.com
ZOHO_SMTP_PASS=your-zoho-app-specific-password
# Where enquiries are delivered (defaults to ZOHO_SMTP_USER if unset)
CONTACT_TO=contact@algorythmos.com
