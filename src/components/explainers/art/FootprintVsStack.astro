---
/** Two different routes to more bits: narrower cells in one layer, or several layers of cells. */
import { asLocale, useTranslations } from '@/i18n';
const t = useTranslations(asLocale(Astro.currentLocale));
const L = (name: string) => t(`explainers.footprint-vs-stack.labels.${name}`);
/** Six wide cells and nine narrow ones across the same width. */
const wide = [0, 1, 2, 3, 4, 5].map((i) => 36 + i * 38);
const narrow = [0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => 36 + i * 25);
/** Layer heights of the stack, bottom first. */
const layers = [200, 172, 144, 116];
const cells = [0, 1, 2, 3, 4, 5].map((i) => 340 + i * 30);
---

<svg class="ex-art" viewBox="0 0 560 300" aria-hidden="true" focusable="false">
  <path class="ex-link ex-dash" d="M290 30V250"></path>

  {/* 0: today's cells, side by side in one layer */}
  {wide.map((x) => <rect class="ex-node" data-at="0" x={x} y="62" width="30" height="40" rx="3"></rect>)}
  <text class="ex-sub" data-at="0" x="148" y="50" text-anchor="middle">{L('today')}</text>

  {/* 1: narrower cells: more of them in the same width */}
  {narrow.map((x) => <rect class="ex-node-brand" data-at="1" x={x} y="150" width="18" height="40" rx="3"></rect>)}
  <text class="ex-sub" data-at="1" x="148" y="138" text-anchor="middle">{L('narrow')}</text>

  {/* 2: still a single layer of cells */}
  <path class="ex-flow-2" data-at="2" d="M36 204H254"></path>
  <text class="ex-sub" data-at="2" x="148" y="224" text-anchor="middle">{L('one')}</text>

  {/* 3: the other route: lay the cells on their side */}
  <rect class="ex-node" data-at="3" x="330" y={layers[0]} width="190" height="20" rx="3"></rect>
  {cells.map((x) => <rect class="ex-chip" data-at="3" x={x} y={layers[0] + 5} width="20" height="10" rx="2"></rect>)}

  {/* 4: and stack layer on layer */}
  {layers.slice(1).map((y) => <rect class="ex-node-brand" data-at="4" x="330" y={y} width="190" height="20" rx="3"></rect>)}
  {layers.slice(1).map((y) => cells.map((x) => <rect class="ex-chip" data-at="4" x={x} y={y + 5} width="20" height="10" rx="2"></rect>))}
  <text class="ex-sub" data-at="4" x="425" y="100" text-anchor="middle">{L('stack')}</text>

  {/* 5: both raise density; they are not the same thing */}
  <path class="ex-ok" data-at="5" d="M138 248l7 7l12 -15"></path>
  <path class="ex-ok" data-at="5" d="M415 248l7 7l12 -15"></path>
  <text class="ex-sub" data-at="5" x="280" y="284" text-anchor="middle">{L('both')}</text>
</svg>
