---
/** A long fibre route: pulses fade, an amplifier boosts them and adds noise, a regenerator rebuilds them. */
import { asLocale, useTranslations } from '@/i18n';
const t = useTranslations(asLocale(Astro.currentLocale));
const L = (name: string) => t(`explainers.fibre-span.labels.${name}`);
/** Transmitter, amplifier, regenerator, receiver: centres, left to right. */
const xs = [56, 206, 356, 506];
const Y = 160;
/** Strong pulses just after the node at `x`; faded, spread pulses just before the next one. */
const strong = (x: number) => [44, 56, 68].map((d) => ({ x: x + d, y: Y - 44, w: 5, h: 32 }));
const faded = (x: number) => [-80, -66, -52].map((d) => ({ x: x + d, y: Y - 22, w: 9, h: 10 }));
---

<svg class="ex-art" viewBox="0 0 560 300" aria-hidden="true" focusable="false">
  <path class="ex-link" d={`M${xs[0]} ${Y}H${xs[3]}`}></path>
  {xs.map((x) => <rect class="ex-node" x={x - 28} y={Y - 20} width="56" height="40" rx="8"></rect>)}
  <text class="ex-sub" x={xs[0]} y="206" text-anchor="middle">{L('tx')}</text>
  <text class="ex-sub" x={xs[1]} y="206" text-anchor="middle">{L('amp')}</text>
  <text class="ex-sub" x={xs[2]} y="206" text-anchor="middle">{L('regen')}</text>
  <text class="ex-sub" x={xs[3]} y="206" text-anchor="middle">{L('rx')}</text>

  {/* 0: the transmitter encodes the bits */}
  <rect class="ex-node-brand" data-at="0" x={xs[0] - 28} y={Y - 20} width="56" height="40" rx="8"></rect>
  {strong(xs[0]).map((p) => <rect class="ex-token" data-at="0" x={p.x} y={p.y} width={p.w} height={p.h} rx="2"></rect>)}

  {/* 1: the pulses weaken and spread */}
  {faded(xs[1]).map((p) => <rect class="ex-chip" data-at="1" x={p.x} y={p.y} width={p.w} height={p.h} rx="2"></rect>)}
  <text class="ex-sub" data-at="1" x={(xs[0] + xs[1]) / 2} y="100" text-anchor="middle">{L('loss')}</text>

  {/* 2: the amplifier boosts the light and adds noise */}
  <rect class="ex-node-brand" data-at="2" x={xs[1] - 28} y={Y - 20} width="56" height="40" rx="8"></rect>
  {strong(xs[1]).map((p) => <rect class="ex-token" data-at="2" x={p.x} y={p.y} width={p.w} height={p.h} rx="2"></rect>)}
  {strong(xs[1]).map((p) => <rect class="ex-warn" data-at="2" x={p.x + 5} y={p.y + 22} width="5" height="10" rx="1"></rect>)}
  <text class="ex-sub" data-at="2" x={xs[1] + 58} y="100" text-anchor="middle">{L('noise')}</text>

  {/* 3: more glass, more loss */}
  {faded(xs[2]).map((p) => <rect class="ex-chip" data-at="3" x={p.x} y={p.y} width={p.w} height={p.h} rx="2"></rect>)}

  {/* 4: the regenerator sends a fresh signal */}
  <rect class="ex-node-brand" data-at="4" x={xs[2] - 28} y={Y - 20} width="56" height="40" rx="8"></rect>
  {strong(xs[2]).map((p) => <rect class="ex-token-2" data-at="4" x={p.x} y={p.y} width={p.w} height={p.h} rx="2"></rect>)}
  <text class="ex-sub" data-at="4" x={xs[2] + 58} y="100" text-anchor="middle">{L('clean')}</text>

  {/* 5: the receiver decodes and the code repairs */}
  <path class="ex-ok" data-at="5" d={`M${xs[3] - 11} ${Y}l8 8l14 -16`}></path>
</svg>
