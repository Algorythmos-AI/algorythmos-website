---
/** Satellite internet today: radio up, laser across, radio down, then ordinary fibre. */
import { asLocale, useTranslations } from '@/i18n';
const t = useTranslations(asLocale(Astro.currentLocale));
const L = (name: string) => t(`explainers.sat-links.labels.${name}`);
const sats = [
  { x: 150, y: 70 },
  { x: 280, y: 44 },
  { x: 410, y: 70 },
];
const DISH = 70;
const GATE = 396;
const DC = 498;
const G = 250;
---

<svg class="ex-art" viewBox="0 0 560 300" aria-hidden="true" focusable="false">
  <path class="ex-link" d="M0 262H560"></path>
  <path class="ex-link ex-dash" d="M70 104Q280 -6 490 104"></path>
  {sats.map((s) => <rect class="ex-node-brand" x={s.x - 12} y={s.y - 8} width="24" height="16" rx="3"></rect>)}
  <rect class="ex-node" x={DISH - 12} y={G - 4} width="24" height="16" rx="3"></rect>
  <text class="ex-sub" x={DISH} y="284" text-anchor="middle">{L('dish')}</text>
  <rect class="ex-node" x={GATE - 12} y={G - 4} width="24" height="16" rx="3"></rect>
  <text class="ex-sub" x={GATE} y="284" text-anchor="middle">{L('gateway')}</text>
  <rect class="ex-node" x={DC - 14} y={G - 14} width="28" height="26" rx="3"></rect>
  <text class="ex-sub" x={DC} y="284" text-anchor="middle">{L('centre')}</text>

  {/* 0: radio up from the dish */}
  <path class="ex-flow ex-dash" data-at="0" d={`M${DISH} ${G - 4}L${sats[0].x - 6} ${sats[0].y + 9}`}></path>
  <text class="ex-sub" data-at="0" x="70" y="160" text-anchor="middle">{L('radio')}</text>
  <circle class="ex-token ex-fly" data-at="0" data-until="1" cx={sats[0].x} cy={sats[0].y + 18} r="6" style="--fx:-76px;--fy:150px"></circle>

  {/* 1 and 2: laser from satellite to satellite */}
  <path class="ex-flow-2" data-at="1" d={`M${sats[0].x + 13} ${sats[0].y - 2}L${sats[1].x - 13} ${sats[1].y + 2}`}></path>
  <text class="ex-sub" data-at="1" x="280" y="88" text-anchor="middle">{L('laser')}</text>
  <circle class="ex-token ex-fly" data-at="1" data-until="2" cx={sats[1].x} cy={sats[1].y + 18} r="6" style="--fx:-130px;--fy:26px"></circle>
  <path class="ex-flow-2" data-at="2" d={`M${sats[1].x + 13} ${sats[1].y + 2}L${sats[2].x - 13} ${sats[2].y - 2}`}></path>
  <circle class="ex-token ex-fly" data-at="2" data-until="3" cx={sats[2].x} cy={sats[2].y + 18} r="6" style="--fx:-130px;--fy:-26px"></circle>

  {/* 3: radio down to a gateway */}
  <path class="ex-flow ex-dash" data-at="3" d={`M${sats[2].x} ${sats[2].y + 9}L${GATE} ${G - 4}`}></path>
  <circle class="ex-token ex-fly" data-at="3" data-until="4" cx={GATE} cy={G - 14} r="6" style="--fx:-10px;--fy:-150px"></circle>

  {/* 4: onto fibre to a data centre */}
  <path class="ex-flow" data-at="4" d={`M${GATE + 12} ${G + 4}H${DC - 14}`}></path>
  <text class="ex-sub" data-at="4" x={(GATE + DC) / 2} y="232" text-anchor="middle">{L('fibre')}</text>
  <circle class="ex-token ex-fly" data-at="4" data-until="5" cx={DC} cy={G - 24} r="6" style="--fx:-80px;--fy:14px"></circle>

  {/* 5: the answer returns the same way */}
  <circle class="ex-ok-fill ex-fly" data-at="5" cx={DISH} cy={G - 16} r="7" style="--fx:326px;--fy:0px"></circle>
</svg>
