---
/** The whole job: the agent dispatches, robots load, the satellite relays, a person approves, payment settles. */
import { asLocale, useTranslations } from '@/i18n';
const t = useTranslations(asLocale(Astro.currentLocale));
const L = (name: string) => t(`explainers.whole-job.labels.${name}`);

const toRobots = 'M205 48C120 48 81 80 81 130';
const toSatellite = 'M146 172C230 218 330 218 414 172';
const toAgent = 'M479 130C479 80 440 48 355 48';
const toApproval = 'M280 76V118';
const toPayment = 'M280 174V228';
---

<svg class="ex-art" viewBox="0 0 560 300" aria-hidden="true" focusable="false">
  <defs>
    <marker id="ex-job-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path class="ex-arrow" d="M0 0 10 5 0 10z"></path>
    </marker>
  </defs>

  {/* Wiring */}
  {[toRobots, toSatellite, toAgent, toApproval, toPayment].map((d) => <path class="ex-link" d={d} marker-end="url(#ex-job-arrow)"></path>)}

  {/* The job's path, lit step by step */}
  <path class="ex-flow" data-at="1" d={toRobots}></path>
  <path class="ex-flow" data-at="2" d={toSatellite}></path>
  <path class="ex-flow" data-at="3" d={toAgent}></path>
  <path class="ex-flow" data-at="4" d={toApproval}></path>
  <path class="ex-flow" data-at="5" d={toPayment}></path>

  {/* Nodes */}
  <rect class="ex-node-brand" x="205" y="20" width="150" height="56" rx="12"></rect>
  <text class="ex-label" x="280" y="53" text-anchor="middle">{L('agent')}</text>

  <rect class="ex-node" x="16" y="130" width="130" height="56" rx="10"></rect>
  <text class="ex-label" x="81" y="163" text-anchor="middle">{L('robots')}</text>

  <rect class="ex-node" x="414" y="130" width="130" height="56" rx="10"></rect>
  <text class="ex-label" x="479" y="163" text-anchor="middle">{L('satellite')}</text>

  <rect class="ex-node" x="205" y="118" width="150" height="56" rx="10"></rect>
  <text class="ex-label" x="272" y="151" text-anchor="middle">{L('approval')}</text>
  <path class="ex-ok" data-at="4" d="M330 146l5 5 9-10"></path>

  <rect class="ex-node" x="205" y="228" width="150" height="56" rx="10"></rect>
  <text class="ex-label" x="272" y="261" text-anchor="middle">{L('payment')}</text>
  <path class="ex-ok" data-at="5" d="M330 256l5 5 9-10"></path>

  {/* The job in flight */}
  <circle class="ex-token ex-fly" data-at="0" data-until="1" cx="196" cy="48" r="7" style="--fx:-190px"></circle>
  <circle class="ex-token ex-fly" data-at="1" data-until="2" cx="81" cy="122" r="7" style="--fx:124px;--fy:-74px"></circle>
  <circle class="ex-token ex-fly" data-at="2" data-until="3" cx="406" cy="176" r="7" style="--fx:-260px"></circle>
  <circle class="ex-token ex-fly" data-at="3" data-until="4" cx="363" cy="48" r="7" style="--fx:116px;--fy:82px"></circle>
</svg>
