---
/**
 * Honest social proof — sectors Algorythmos actually serves. No client names, except an
 * approved partner in a link label (see docs/COPY_CLAIMS_SIGNOFF.md §3f).
 * Grounded in the case studies + stated industry focus; labels are i18n (EN/FR).
 */
import { asLocale, useTranslations, localizePath } from '@/i18n';
const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);
const sectors = ['healthcare', 'finance', 'manufacturing', 'retail', 'logistics', 'mining'] as const;
/** Sector → the case study that proves it (chips without proof stay plain text). */
const PROOF: Partial<Record<(typeof sectors)[number], string>> = {
  healthcare: 'healthcare-burden',
  finance: 'financial-compliance',
  manufacturing: 'manufacturing-docs',
  retail: 'retail-sql',
  logistics: 'port-botany-ai-ml',
};
/** Sector → a blog post that shows our work there (no case study yet). */
const POST: Partial<Record<(typeof sectors)[number], string>> = {
  mining: 'mbsc-australia-partnership',
};
const chipClass = 'inline-flex items-center gap-2.5 rounded-full border border-line glass px-4 py-2 text-sm font-medium text-ink';
---

<section class="border-y border-line bg-surface-2/30">
  <div class="container-page py-16 text-center">
    <h2 data-reveal class="text-xs font-semibold uppercase tracking-[0.2em] text-ink-subtle">
      {t('home.industries.title')}
    </h2>
    <p data-reveal style="--reveal-delay: 60ms" class="mx-auto mt-3 max-w-2xl text-ink-muted">
      {t('home.industries.lead')}
    </p>
    <ul data-reveal style="--reveal-delay: 120ms" class="mt-8 flex flex-wrap items-center justify-center gap-3">
      {sectors.map((s) => (
        <li>
          {PROOF[s] ? (
            <a
              href={localizePath(locale, `/case-studies/${PROOF[s]}`)}
              class={`${chipClass} transition-colors hover:border-brand hover:text-brand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-bg`}
              aria-label={t('home.industries.proofLabel', { sector: t(`industries.${s}`) })}
            >
              <span class="h-1.5 w-1.5 rounded-full bg-grad-cta" aria-hidden="true"></span>
              {t(`industries.${s}`)}
              <span aria-hidden="true">→</span>
            </a>
          ) : POST[s] ? (
            <a
              href={localizePath(locale, `/blog/${POST[s]}`)}
              class={`${chipClass} transition-colors hover:border-brand hover:text-brand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-bg`}
              aria-label={t('home.industries.partnerLabel', { sector: t(`industries.${s}`) })}
            >
              <span class="h-1.5 w-1.5 rounded-full bg-grad-cta" aria-hidden="true"></span>
              {t(`industries.${s}`)}
              <span aria-hidden="true">→</span>
            </a>
          ) : (
            <span class={chipClass}>
              <span class="h-1.5 w-1.5 rounded-full bg-grad-cta" aria-hidden="true"></span>
              {t(`industries.${s}`)}
            </span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
