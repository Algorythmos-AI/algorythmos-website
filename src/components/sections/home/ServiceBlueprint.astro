---
/**
 * ServiceBlueprint — extend.ai-inspired technical showcase, dark-blueprint edition.
 *
 * Numbered service tabs ([01]–[04], /slug styling) · an isometric SVG "figure"
 * per service (BlueprintFigure + BlueprintArt) · a [CAPABILITIES] panel.
 * Vanilla tabs (no React), all copy from i18n.
 */
import { asLocale, useTranslations, localizePath } from '@/i18n';
import BlueprintFigure from '@/components/ui/BlueprintFigure.astro';
import BlueprintArt from '@/components/ui/BlueprintArt.astro';

const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);

const services = [
  { slug: 'agentic-automation', key: 's0', art: 'agentic' },
  { slug: 'document-intelligence', key: 's1', art: 'document' },
  { slug: 'sql-dashboards', key: 's2', art: 'sql' },
  { slug: 'mlops-cicd', key: 's3', art: 'mlops' },
] as const;
---

<section class="border-y border-line/60 bg-surface-1/40">
  <div class="container-page py-24">
    <div data-reveal class="max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent">[ {t('blueprint.tag')} ]</p>
      <h2 class="mt-3 text-h2 font-bold tracking-tight text-ink">{t('blueprint.heading')}</h2>
      <p class="mt-3 text-ink-muted">{t('blueprint.sub')}</p>
    </div>

    <div data-reveal style="--reveal-delay: 120ms" class="mt-14 grid gap-8 lg:grid-cols-[240px_minmax(0,1fr)_280px]" data-blueprint>
      {/* ── Service tabs ─────────────────────────────── */}
      <div class="lg:flex lg:flex-col">
      {/* Only role=tab children may live inside a tablist (WAI-ARIA); the catalogue link sits outside it. */}
      <div role="tablist" aria-label={t('blueprint.tag')} class="grid grid-cols-2 gap-2 lg:flex lg:flex-col lg:gap-0 lg:divide-y lg:divide-line/60">
        {services.map((s, i) => (
          <button
            type="button"
            role="tab"
            id={`bp-tab-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`bp-panel-${i}`}
            data-bp-tab={i}
            class="bp-tab group shrink-0 rounded-lg px-3 py-4 text-left transition-colors lg:rounded-none lg:px-1 lg:py-5"
          >
            <span class="font-mono text-xs text-ink-subtle transition-colors group-aria-selected:text-accent">[0{i + 1}]</span>
            <span class="mt-1 block break-words font-mono text-xs font-semibold text-ink-muted transition-colors group-hover:text-ink group-aria-selected:text-ink sm:text-sm">
              /{s.slug}
            </span>
          </button>
        ))}
      </div>
        <a
          href={localizePath(locale, '/services')}
          class="hidden items-center gap-1.5 border-t border-line/60 pt-5 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand hover:underline lg:inline-flex"
        >
          {t('nav.services')}
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      {/* ── Figures ──────────────────────────────────── */}
      <div class="relative">
        {services.map((s, i) => (
          <div role="tabpanel" id={`bp-panel-${i}`} aria-labelledby={`bp-tab-${i}`} data-bp-panel={i} hidden={i !== 0}>
            <BlueprintFigure fig={`0${i + 1}`} class="bp-showcase-figure aspect-[4/3] lg:aspect-auto lg:h-full lg:min-h-[420px]">
              <BlueprintArt kind={s.art} />
            </BlueprintFigure>
          </div>
        ))}
      </div>

      {/* ── Capabilities panel ───────────────────────── */}
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-ink-subtle">[ {t('blueprint.capsLabel')} ]</p>
        {services.map((s, i) => (
          <div data-bp-caps={i} hidden={i !== 0} class="mt-2 divide-y divide-line/60">
            <p class="py-4 text-sm leading-relaxed text-ink-muted">{t(`blueprint.${s.key}.desc`)}</p>
            {[0, 1, 2].map((c) => (
              <div class="py-4">
                <h3 class="text-sm font-semibold text-ink">{t(`blueprint.${s.key}.caps.${c}.title`)}</h3>
                <p class="mt-1 text-sm leading-relaxed text-ink-muted">{t(`blueprint.${s.key}.caps.${c}.desc`)}</p>
              </div>
            ))}
            <a
              href={localizePath(locale, `/services/${s.slug}`)}
              class="inline-flex items-center gap-1.5 py-4 text-sm font-semibold text-brand hover:underline"
            >
              {t(`blueprint.${s.key}.name`)}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Panel wrappers must fill the middle column height on desktop */
  [data-bp-panel] {
    height: 100%;
  }
  .bp-tab[aria-selected='true'] {
    background: rgb(var(--surface-2) / 0.5);
  }
  @media (min-width: 1024px) {
    .bp-tab[aria-selected='true'] {
      background: transparent;
    }
  }
</style>

<script>
  function setupBlueprint() {
    const root = document.querySelector('[data-blueprint]');
    if (!(root instanceof HTMLElement) || root.dataset.bpInit) return;
    root.dataset.bpInit = '1';
    const tabs = Array.from(root.querySelectorAll<HTMLElement>('[data-bp-tab]'));
    const show = (idx: string) => {
      tabs.forEach((t) => {
        const on = t.getAttribute('data-bp-tab') === idx;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.setAttribute('tabindex', on ? '0' : '-1');
      });
      root.querySelectorAll<HTMLElement>('[data-bp-panel]').forEach((p) => {
        p.hidden = p.getAttribute('data-bp-panel') !== idx;
      });
      root.querySelectorAll<HTMLElement>('[data-bp-caps]').forEach((p) => {
        p.hidden = p.getAttribute('data-bp-caps') !== idx;
      });
    };
    tabs.forEach((t, i) => {
      t.setAttribute('tabindex', t.getAttribute('aria-selected') === 'true' ? '0' : '-1');
      t.addEventListener('click', () => show(t.getAttribute('data-bp-tab') || '0'));
      /* WAI-ARIA tabs: arrows / Home / End move focus and select */
      t.addEventListener('keydown', (e: KeyboardEvent) => {
        const keys: Record<string, number> = { ArrowRight: i + 1, ArrowDown: i + 1, ArrowLeft: i - 1, ArrowUp: i - 1, Home: 0, End: tabs.length - 1 };
        if (!(e.key in keys)) return;
        e.preventDefault();
        const next = tabs[(keys[e.key] + tabs.length) % tabs.length] as HTMLElement;
        next.focus();
        show(next.getAttribute('data-bp-tab') || '0');
      });
    });
  }
  document.addEventListener('astro:page-load', setupBlueprint);
  /* Initialize immediately if astro:page-load already fired before this module ran */
  if (document.readyState !== 'loading') setupBlueprint();
</script>
