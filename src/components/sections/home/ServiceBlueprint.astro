---
/**
 * ServiceBlueprint — extend.ai-inspired technical showcase, dark-blueprint edition.
 *
 * Numbered service tabs ([01]–[04], /slug styling) · an isometric SVG "figure"
 * per service drawn on a graph grid with a ( FIG.0X ) plate label · a
 * [CAPABILITIES] panel. Vanilla tabs (no React), all copy from i18n,
 * illustrations are aria-hidden decorative SVG with reduced-motion-gated
 * micro-animations (dash flow, scan sweep, needle, pulse).
 */
import { asLocale, useTranslations, localizePath } from '@/i18n';

const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);

const services = [
  { slug: 'agentic-automation', key: 's0' },
  { slug: 'document-intelligence', key: 's1' },
  { slug: 'sql-dashboards', key: 's2' },
  { slug: 'mlops-cicd', key: 's3' },
] as const;
---

<section class="border-y border-line/60 bg-surface-1/40">
  <div class="container-page py-24">
    <div data-reveal class="max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent">[ {t('blueprint.tag')} ]</p>
      <h2 class="mt-3 text-h2 font-bold tracking-tight text-ink">{t('blueprint.heading')}</h2>
      <p class="mt-3 text-ink-muted">{t('blueprint.sub')}</p>
    </div>

    <div data-reveal style="--reveal-delay: 120ms" class="mt-14 grid gap-8 lg:grid-cols-[240px_minmax(0,1fr)_280px]" data-blueprint>
      {/* ── Service tabs ─────────────────────────────── */}
      <div role="tablist" aria-label={t('blueprint.tag')} class="flex gap-2 overflow-x-auto lg:flex-col lg:gap-0 lg:divide-y lg:divide-line/60">
        {services.map((s, i) => (
          <button
            type="button"
            role="tab"
            id={`bp-tab-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`bp-panel-${i}`}
            data-bp-tab={i}
            class="bp-tab group shrink-0 rounded-lg px-3 py-4 text-left transition-colors lg:rounded-none lg:px-1 lg:py-5"
          >
            <span class="font-mono text-xs text-ink-subtle transition-colors group-aria-selected:text-accent">[0{i + 1}]</span>
            <span class="mt-1 block font-mono text-sm font-semibold text-ink-muted transition-colors group-hover:text-ink group-aria-selected:text-ink">
              /{s.slug}
            </span>
          </button>
        ))}
        <a
          href={localizePath(locale, '/services')}
          class="hidden items-center gap-1.5 pt-5 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand hover:underline lg:inline-flex"
        >
          {t('nav.services')}
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      {/* ── Figures ──────────────────────────────────── */}
      <div class="relative">
        {services.map((s, i) => (
          <div
            role="tabpanel"
            id={`bp-panel-${i}`}
            aria-labelledby={`bp-tab-${i}`}
            data-bp-panel={i}
            hidden={i !== 0}
            class="bp-figure relative overflow-hidden rounded-2xl border border-line bg-bg/60"
          >
            <span class="absolute bottom-4 left-3 select-none font-mono text-[10px] tracking-[0.2em] text-ink-subtle [writing-mode:vertical-rl]" aria-hidden="true">
              ( FIG.0{i + 1} )
            </span>
            <span class="bp-tick bp-tick-tl" aria-hidden="true"></span>
            <span class="bp-tick bp-tick-tr" aria-hidden="true"></span>
            <span class="bp-tick bp-tick-bl" aria-hidden="true"></span>
            <span class="bp-tick bp-tick-br" aria-hidden="true"></span>

            {i === 0 && (
              /* Agentic automation — stacked isometric planes, flowing connector */
              <svg viewBox="0 0 480 360" fill="none" aria-hidden="true" class="mx-auto block h-full w-full max-w-[560px] p-8">
                <g stroke="rgb(var(--brand))" stroke-width="1.5">
                  <path d="M240 36 356 94 240 152 124 94Z" fill="rgb(var(--brand) / 0.10)" />
                  <path d="M240 152v14M356 94v14M124 94v14" stroke-dasharray="3 4" opacity="0.7" />
                  <path d="M240 84 296 112 240 140 184 112Z" fill="rgb(var(--accent) / 0.14)" stroke="rgb(var(--accent))" />
                </g>
                <g stroke="rgb(var(--brand))" stroke-width="1.5" opacity="0.85">
                  <path d="M240 132 388 206 240 280 92 206Z" fill="rgb(var(--surface-2) / 0.9)" />
                  <path d="M92 206v18l148 74v-18M388 206v18l-148 74v-18" fill="rgb(var(--surface-3) / 0.9)" />
                </g>
                <g class="bp-flow" stroke="rgb(var(--accent))" stroke-width="1.5" stroke-dasharray="6 6">
                  <path d="M240 152v-12M240 132 148 178M240 132l92 46" />
                </g>
                <g stroke="rgb(var(--text-muted))" stroke-width="1.2" opacity="0.55">
                  <path d="M170 206h60M170 220h90M170 234h44" />
                  <rect x="268" y="200" width="70" height="38" rx="4" stroke="rgb(var(--accent))" />
                  <path d="M278 212h50M278 222h34" />
                </g>
                <circle class="bp-pulse" cx="240" cy="112" r="4" fill="rgb(var(--accent))" />
                <circle class="bp-pulse" cx="303" cy="219" r="3" fill="rgb(var(--brand))" style="animation-delay: 1.1s" />
              </svg>
            )}
            {i === 1 && (
              /* Document intelligence — isometric sheet, scan sweep, confidence chip */
              <svg viewBox="0 0 480 360" fill="none" aria-hidden="true" class="mx-auto block h-full w-full max-w-[560px] p-8">
                <g stroke="rgb(var(--brand))" stroke-width="1.5">
                  <path d="M240 52 400 132 240 212 80 132Z" fill="rgb(var(--surface-2) / 0.9)" />
                  <path d="M80 132v16l160 80v-16M400 132v16l-160 80v-16" fill="rgb(var(--surface-3) / 0.9)" />
                </g>
                <g stroke="rgb(var(--text-muted))" stroke-width="1.2" opacity="0.6">
                  <path d="M170 118h80M158 132h120M172 146h70M200 160h60" />
                  <path d="M300 96l36 18" stroke="rgb(var(--accent))" />
                </g>
                <line class="bp-scan" x1="120" y1="132" x2="360" y2="132" stroke="rgb(var(--accent))" stroke-width="1.5" opacity="0.9" />
                <g class="bp-float">
                  <circle cx="322" cy="196" r="34" stroke="rgb(var(--accent))" stroke-width="2" fill="rgb(var(--accent) / 0.08)" />
                  <path d="M346 220l26 26" stroke="rgb(var(--accent))" stroke-width="3" stroke-linecap="round" />
                  <path d="M308 192h28M308 202h18" stroke="rgb(var(--text))" stroke-width="1.5" opacity="0.8" />
                </g>
                <g class="bp-float" style="animation-delay: 1.6s">
                  <rect x="96" y="228" width="118" height="30" rx="6" fill="rgb(var(--surface-3))" stroke="rgb(var(--brand))" stroke-width="1.2" />
                  <circle cx="114" cy="243" r="4" fill="rgb(var(--success))" />
                  <path d="M128 240h72M128 248h48" stroke="rgb(var(--text-muted))" stroke-width="1.5" />
                </g>
              </svg>
            )}
            {i === 2 && (
              /* SQL dashboards — isometric plate with 3D bars + trend line */
              <svg viewBox="0 0 480 360" fill="none" aria-hidden="true" class="mx-auto block h-full w-full max-w-[560px] p-8">
                <g stroke="rgb(var(--brand))" stroke-width="1.5">
                  <path d="M240 120 408 204 240 288 72 204Z" fill="rgb(var(--surface-2) / 0.9)" />
                  <path d="M72 204v16l168 84v-16M408 204v16l-168 84v-16" fill="rgb(var(--surface-3) / 0.9)" />
                </g>
                {[
                  { x: 168, y: 196, h: 54, c: 'brand' },
                  { x: 216, y: 214, h: 86, c: 'accent' },
                  { x: 264, y: 196, h: 64, c: 'brand' },
                  { x: 312, y: 214, h: 110, c: 'accent' },
                ].map((b) => (
                  <g stroke={`rgb(var(--${b.c}))`} stroke-width="1.4">
                    <path d={`M${b.x} ${b.y}v-${b.h}l24 12v${b.h}Z`} fill={`rgb(var(--${b.c}) / 0.25)`} />
                    <path d={`M${b.x} ${b.y - b.h}l12 -6 24 12 -12 6Z`} fill={`rgb(var(--${b.c}) / 0.45)`} />
                  </g>
                ))}
                <path class="bp-draw" d="M150 180 C 200 130, 260 150, 300 110 S 380 80, 396 92" stroke="rgb(var(--accent))" stroke-width="2" stroke-linecap="round" />
                <circle class="bp-pulse" cx="396" cy="92" r="4" fill="rgb(var(--accent))" />
              </svg>
            )}
            {i === 3 && (
              /* MLOps — pipeline gauge with needle + stage nodes */
              <svg viewBox="0 0 480 360" fill="none" aria-hidden="true" class="mx-auto block h-full w-full max-w-[560px] p-8">
                <path d="M120 260a120 120 0 0 1 240 0" stroke="rgb(var(--border-strong))" stroke-width="26" stroke-linecap="round" opacity="0.5" />
                <path d="M120 260a120 120 0 0 1 240 0" stroke="url(#bp-gauge)" stroke-width="26" stroke-linecap="round" stroke-dasharray="260 380" class="bp-gauge-fill" />
                <defs>
                  <linearGradient id="bp-gauge" x1="120" y1="260" x2="360" y2="260" gradientUnits="userSpaceOnUse">
                    <stop stop-color="rgb(var(--brand))" />
                    <stop offset="1" stop-color="rgb(var(--accent))" />
                  </linearGradient>
                </defs>
                <g class="bp-needle" style="transform-origin: 240px 260px">
                  <line x1="240" y1="260" x2="240" y2="172" stroke="rgb(var(--text))" stroke-width="2.5" stroke-linecap="round" />
                  <circle cx="240" cy="260" r="6" fill="rgb(var(--text))" />
                </g>
                {[
                  { cx: 132, cy: 244 },
                  { cx: 176, cy: 176 },
                  { cx: 240, cy: 148 },
                  { cx: 304, cy: 176 },
                  { cx: 348, cy: 244 },
                ].map((n, j) => (
                  <circle class="bp-pulse" cx={n.cx} cy={n.cy} r="4.5" fill="rgb(var(--brand))" style={`animation-delay: ${j * 0.5}s`} />
                ))}
                <g stroke="rgb(var(--text-muted))" stroke-width="1.2" opacity="0.6">
                  <rect x="176" y="288" width="128" height="30" rx="6" stroke="rgb(var(--accent))" />
                  <path d="M192 300h96M192 308h64" />
                </g>
              </svg>
            )}
          </div>
        ))}
      </div>

      {/* ── Capabilities panel ───────────────────────── */}
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-ink-subtle">[ {t('blueprint.capsLabel')} ]</p>
        {services.map((s, i) => (
          <div data-bp-caps={i} hidden={i !== 0} class="mt-2 divide-y divide-line/60">
            <p class="py-4 text-sm leading-relaxed text-ink-muted">{t(`blueprint.${s.key}.desc`)}</p>
            {[0, 1, 2].map((c) => (
              <div class="py-4">
                <h3 class="text-sm font-semibold text-ink">{t(`blueprint.${s.key}.caps.${c}.title`)}</h3>
                <p class="mt-1 text-sm leading-relaxed text-ink-muted">{t(`blueprint.${s.key}.caps.${c}.desc`)}</p>
              </div>
            ))}
            <a
              href={localizePath(locale, `/services/${s.slug}`)}
              class="inline-flex items-center gap-1.5 py-4 text-sm font-semibold text-brand hover:underline"
            >
              {t(`blueprint.${s.key}.name`)}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Graph-paper grid inside each figure */
  .bp-figure {
    aspect-ratio: 4 / 3;
    background-image:
      linear-gradient(rgb(var(--border) / 0.35) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--border) / 0.35) 1px, transparent 1px);
    background-size: 28px 28px;
  }
  @media (min-width: 1024px) {
    .bp-figure {
      aspect-ratio: auto;
      height: 100%;
      min-height: 420px;
    }
  }
  /* Corner ticks, extend.ai style */
  .bp-tick {
    position: absolute;
    height: 5px;
    width: 5px;
    border-radius: 9999px;
    background: rgb(var(--text-subtle) / 0.6);
  }
  .bp-tick-tl { top: 10px; left: 10px; }
  .bp-tick-tr { top: 10px; right: 10px; }
  .bp-tick-bl { bottom: 10px; left: 10px; }
  .bp-tick-br { bottom: 10px; right: 10px; }

  .bp-tab[aria-selected='true'] {
    background: rgb(var(--surface-2) / 0.5);
  }
  @media (min-width: 1024px) {
    .bp-tab[aria-selected='true'] {
      background: transparent;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .bp-flow {
      animation: bp-dash 1.6s linear infinite;
    }
    .bp-scan {
      animation: bp-scan 3.4s ease-in-out infinite;
    }
    .bp-float {
      animation: bp-float 5s ease-in-out infinite;
    }
    .bp-pulse {
      animation: bp-pulse 2.2s ease-in-out infinite;
    }
    .bp-needle {
      animation: bp-needle 4.5s ease-in-out infinite;
    }
    .bp-draw {
      stroke-dasharray: 420;
      stroke-dashoffset: 420;
      animation: bp-draw 2.2s var(--ease-quint) forwards;
    }
  }
  @keyframes bp-dash {
    to { stroke-dashoffset: -24; }
  }
  @keyframes bp-scan {
    0%, 100% { transform: translateY(-34px); opacity: 0.25; }
    50% { transform: translateY(44px); opacity: 0.9; }
  }
  @keyframes bp-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-7px); }
  }
  @keyframes bp-pulse {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 1; }
  }
  @keyframes bp-needle {
    0%, 100% { transform: rotate(-32deg); }
    50% { transform: rotate(38deg); }
  }
  @keyframes bp-draw {
    to { stroke-dashoffset: 0; }
  }
</style>

<script>
  function setupBlueprint() {
    const root = document.querySelector('[data-blueprint]');
    if (!(root instanceof HTMLElement) || root.dataset.bpInit) return;
    root.dataset.bpInit = '1';
    const tabs = Array.from(root.querySelectorAll('[data-bp-tab]'));
    const show = (idx: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', t.getAttribute('data-bp-tab') === idx ? 'true' : 'false'));
      root.querySelectorAll<HTMLElement>('[data-bp-panel]').forEach((p) => {
        p.hidden = p.getAttribute('data-bp-panel') !== idx;
      });
      root.querySelectorAll<HTMLElement>('[data-bp-caps]').forEach((p) => {
        p.hidden = p.getAttribute('data-bp-caps') !== idx;
      });
    };
    tabs.forEach((t) => t.addEventListener('click', () => show(t.getAttribute('data-bp-tab') || '0')));
  }
  document.addEventListener('astro:page-load', setupBlueprint);
  /* Initialize immediately if astro:page-load already fired before this module ran */
  if (document.readyState !== 'loading') setupBlueprint();
</script>
