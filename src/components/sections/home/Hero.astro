---
import { asLocale, useTranslations, localizePath } from '@/i18n';
import Button from '@/components/ui/Button.astro';
import Aurora from '@/components/ui/Aurora.astro';
import NeuralOrb from '@/components/ui/NeuralOrb.astro';
import NeuralField from '@/components/ui/NeuralField.astro';
import HeroConsole from '@/components/sections/home/HeroConsole.astro';
import { bookingUrl } from '@/lib/links';

const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section class="hero relative overflow-hidden">
  <Aurora />
  <NeuralField />
  {/* Full-viewport opening: nav + hero copy own the first screen (100svh minus the 4rem header) */}
  <div class="hero-viewport container-page relative flex flex-col justify-center pb-20 pt-10 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)] lg:items-center lg:gap-12">
    <div>
    <p data-reveal class="inline-flex max-w-max items-center gap-2 rounded-full glass px-3.5 py-1.5 text-xs font-medium text-ink-muted">
      <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
      AI Consultancy · Sydney · Paris
    </p>

    <h1
      data-reveal="lcp"
      style="--reveal-delay: 90ms"
      class="mt-6 max-w-5xl text-mega font-extrabold leading-[1.06] tracking-tight text-ink md:leading-[0.98]"
    >
      <span class="text-gradient-brand">{t('hero.title')}</span>
    </h1>

    <p data-reveal="lcp" style="--reveal-delay: 180ms" class="mt-6 max-w-2xl text-lead text-ink-muted">
      {t('hero.subtitle')}
    </p>

    <div data-reveal style="--reveal-delay: 260ms" class="mt-10 flex flex-wrap items-center gap-4">
      <Button href={bookingUrl(locale)} target="_blank" rel="noopener" size="lg" class="w-full sm:w-auto">{t('hero.cta.primary')}</Button>
      <Button href={localizePath(locale, '/pricing')} size="lg" variant="secondary" class="w-full sm:w-auto">{t('hero.cta.secondary')}</Button>
    </div>

    <p data-reveal="fade" style="--reveal-delay: 340ms" class="mt-10 text-sm text-ink-subtle">
      Senior engineers · EU GDPR &amp; Australian Privacy aligned · Outcome-based delivery
    </p>
    </div>

    {/* Neural orb — right column on desktop, compact centerpiece below the copy on mobile */}
    <div data-reveal style="--reveal-delay: 420ms" class="mx-auto mt-12 w-full max-w-[300px] md:max-w-[380px] lg:mt-0 lg:max-w-none">
      <NeuralOrb />
    </div>

    {/* Scroll cue — decorative, sits at the bottom edge of the first viewport */}
    <div
      data-reveal="fade"
      style="--reveal-delay: 700ms"
      class="pointer-events-none absolute bottom-5 left-1/2 -translate-x-1/2"
      aria-hidden="true"
    >
      <svg
        class="h-6 w-6 animate-bounce text-ink-subtle"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
    </div>
  </div>

  <div class="container-page pb-24">
    <HeroConsole />
  </div>
</section>
