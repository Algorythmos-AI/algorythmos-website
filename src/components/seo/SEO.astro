---
import { asLocale, REGIONS, LOCALES, localizePath } from '@/i18n';
import { hasOgCard } from '@/seo/ogPages';
import { ogImageUrl } from '@/seo/schema';

interface Props {
  title: string;
  description: string;
  /** region-relative path, e.g. '/services' or '/blog/gdpr-ai' */
  path?: string;
  ogType?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  /** Single-locale page (e.g. a local landing page): emit a self-canonical only, no cross-locale hreflang. */
  standalone?: boolean;
}

const { title, description, path = '/', ogType = 'website', image, noindex = false, standalone = false } = Astro.props;

const locale = asLocale(Astro.currentLocale);
const site = (Astro.site?.toString() ?? 'https://algorythmos.com').replace(/\/$/, '');
const abs = (loc: typeof locale, p: string) => site + localizePath(loc, p);

/**
 * Canonical consolidation: the unprefixed `en` tree is a near-identical twin of
 * `/au-en` (41 override keys), so root pages canonicalise to their /au-en twin
 * and the sitemap lists only /au-en + /fr-fr. Standalone (single-locale) pages
 * keep a self canonical.
 */
const canonicalLocale = locale === 'en' && !standalone ? 'au-en' : locale;
const canonical = abs(canonicalLocale, path);
/** Indexable locale trees for hreflang; x-default → /au-en. */
const HREFLANG_LOCALES = ['au-en', 'fr-fr'] as const;
/** Brand-first titles (home) stay as they are; everything else gets the brand suffix. */
const fullTitle = /algorythmos/i.test(title) ? title : `${title} | Algorythmos`;
// Prefer the page's generated per-locale OG card; brand card as last resort.
const localizedPath = localizePath(locale, path);
const ogImage = image ?? (hasOgCard(localizedPath) ? ogImageUrl(localizedPath) : `${site}/Algorythmos.png`);
const isPreview = import.meta.env.VERCEL_ENV && import.meta.env.VERCEL_ENV !== 'production';
const robots = noindex || isPreview ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />

{/* hreflang — reciprocal; skipped for standalone single-locale pages (local landing pages) */}
{!standalone && HREFLANG_LOCALES.map((l) => <link rel="alternate" hreflang={REGIONS[l].hreflang} href={abs(l, path)} />)}
{!standalone && <link rel="alternate" hreflang="x-default" href={abs('au-en', path)} />}

{/* PWA / browser chrome */}
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#08080c" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafaf9" />
<link rel="manifest" href="/manifest.json" />

{/* Open Graph */}
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={fullTitle} />
<meta property="og:site_name" content="Algorythmos" />
<meta property="og:locale" content={REGIONS[locale].ogLocale} />
{LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={REGIONS[l].ogLocale} />)}

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@algorythmos" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:url" content={canonical} />
