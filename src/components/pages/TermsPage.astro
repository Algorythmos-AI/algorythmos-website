---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import Button from '@/components/ui/Button.astro';
import { asLocale, useTranslations, localizePath } from '@/i18n';
import { breadcrumb, SITE } from '@/seo/schema';

const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);
const path = '/terms';
const abs = (p: string) => SITE + localizePath(locale, p);

import { BUSINESS } from '@/data/business';
const EMAIL = BUSINESS.email;

const crumbs = breadcrumb([
  { name: t('nav.home'), url: abs('/') },
  { name: t('nav.terms'), url: abs(path) },
]);

const sectionKeys = ['intro', 'scope', 'intellectualProperty', 'limitations', 'governingLaw', 'contact'] as const;
const sections = sectionKeys.map((s) => {
  const base = `terms.sections.${s}`;
  return {
    id: s,
    title: t(`${base}.title`),
    content: t(`${base}.content`).replaceAll('{email}', EMAIL),
  };
});
---

<BaseLayout title={t('terms.meta.title')} description={t('terms.meta.description')} path={path} jsonLd={[crumbs]}>
  <PageHeader eyebrow={t('terms.hero.badge')} title={t('terms.hero.title')} lead={t('terms.hero.subtitle')} />

  <section class="container-page py-20">
    <div class="mx-auto max-w-measure">
      <p class="text-sm text-ink-subtle">
        {t('terms.hero.lastUpdated')} <time>{t('terms.hero.lastUpdatedDate')}</time>
      </p>

      <ol class="mt-10 space-y-12">
        {sections.map((sec, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 40}ms`}>
            <article>
              <h2 class="text-h3 font-semibold text-ink">{sec.title}</h2>
              <p class="mt-3 leading-relaxed text-ink-muted">{sec.content}</p>
            </article>
          </li>
        ))}
      </ol>

      {/* Contact CTA */}
      <div data-reveal class="mt-16 rounded-2xl border border-line glass p-8 text-center">
        <h2 class="text-h3 font-semibold text-ink">{t('terms.cta.title')}</h2>
        <p class="mx-auto mt-2 max-w-xl text-ink-muted">{t('terms.cta.subtitle')}</p>
        <Button href={localizePath(locale, '/contact')} size="lg" class="mt-6">{t('nav.contact')}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
