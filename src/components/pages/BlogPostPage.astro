---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import Button from '@/components/ui/Button.astro';
import { asLocale, useTranslations, localizePath, getDict } from '@/i18n';
import { getPost } from '@/data/blog';
import { getBlogCharts } from '@/data/blogCharts';
import { localizeChart } from '@/lib/localizeChart';
import Chart from '@/components/islands/Chart';
import { breadcrumb, SITE, ORG_ID, FOUNDER_ID, ogImageUrl, isoDateTime } from '@/seo/schema';
import { bookingUrl } from '@/lib/links';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import RelatedLinks from '@/components/ui/RelatedLinks.astro';
import { blogRelated } from '@/data/related';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const post = getPost(slug);
if (!post) throw new Error(`Unknown blog slug: ${slug}`);

const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);

/** Real charts harvested from the legacy layouts, keyed by slug — localized per locale. */
const charts = getBlogCharts(post.slug).map((c) => localizeChart(t, c));
const path = `/blog/${post.slug}`;
const abs = (p: string) => SITE + localizePath(locale, p);
const ogImg = ogImageUrl(localizePath(locale, path));

const base = `blogDetail.posts.${post.slug}`;
const title = t(`${base}.title`);
const description = t(`${base}.meta`);
/* Optional search-only overrides, for a headline or lead that doesn't fit the
   title (≤ 60 incl. " | Algorythmos") or description (70–160) limits. The page
   itself keeps the full headline and lead. */
const seoTitle = getDict(locale)[`${base}.seoTitle`] ?? title;
const seoDescription = getDict(locale)[`${base}.seoDescription`] ?? description;

/** Resolve a prose section's heading + body from either key shape. */
function resolveProse(sectionBase: string, paragraphs?: number[], list?: number[], listKey = 'list') {
  const k = (suffix: string) => `${base}.${sectionBase}.${suffix}`;
  // Uniform posts use `.heading`; the bespoke pulse layout uses `.title`.
  const headingKey = [`${k('heading')}`, `${k('title')}`].find((key) => t(key) !== key);
  const heading = headingKey ? t(headingKey) : '';
  // Body paragraphs: explicit `.paragraphs.N` indices, else the bespoke `.subtitle`/`.desc` keys.
  const paras = (paragraphs ?? []).map((n) => t(k(`paragraphs.${n}`)));
  if (paras.length === 0) {
    for (const key of [k('subtitle'), k('desc')]) {
      if (t(key) !== key) paras.push(t(key));
    }
  }
  const items = (list ?? []).map((n) => t(k(`${listKey}.${n}`)));
  return { heading, paras, items };
}

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: isoDateTime(post.date),
  dateModified: isoDateTime(post.updatedAt ?? post.date),
  image: ogImg,
  author: { '@id': FOUNDER_ID },
  publisher: { '@id': ORG_ID },
  inLanguage: locale === 'fr-fr' ? 'fr' : 'en',
  mainEntityOfPage: { '@type': 'WebPage', '@id': abs(path) },
};
const crumbItems = [
  { name: t('nav.home'), url: abs('/') },
  { name: t('blog.hero.title'), url: abs('/blog') },
  { name: title, url: abs(path) },
];
const crumbs = breadcrumb(crumbItems);

/** Optional FAQ (same key shape as service pages) → visible section + FAQPage schema. */
const faqs: { q: string; a: string }[] = [];
for (let i = 0; i < 12; i++) {
  const q = t(`${base}.faqs.${i}.question`);
  const a = t(`${base}.faqs.${i}.answer`);
  if (q === `${base}.faqs.${i}.question` || a === `${base}.faqs.${i}.answer`) break;
  faqs.push({ q, a });
}
const faqsTitle = faqs.length ? (t(`${base}.faqs.title`) !== `${base}.faqs.title` ? t(`${base}.faqs.title`) : t('serviceAiWebsites.faqs.title')) : '';
const faqLd = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      '@id': `${abs(path)}#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<BaseLayout title={seoTitle} description={seoDescription} path={path} ogType="article" image={ogImg} jsonLd={[articleLd, crumbs, ...(faqLd ? [faqLd] : [])]}>
  <Breadcrumbs items={crumbItems} />
  <PageHeader eyebrow={t(`blog.posts.${post.postIndex}.date`)} title={title} lead={description} />

  <section class="container-page py-20">
    <article class="max-w-measure">
      {/* Author byline — visible E-E-A-T signal mirroring the BlogPosting author schema */}
      <div data-reveal class="mb-12 flex items-center gap-3 border-b border-line pb-6 text-sm">
        <span class="text-ink-subtle">{t('blogDetail.author.by')}</span>
        <a href={localizePath(locale, '/about')} class="font-semibold text-ink underline-offset-4 hover:underline">
          {t('blogDetail.author.name')}
        </a>
        <span class="text-ink-muted">· {t('blogDetail.author.role')}</span>
      </div>

      {post.body.map((block, i) => {
        // Chart placeholder blocks render once, after the prose (below) — skip here to avoid duplication.
        if (block.kind === 'chart') return null;
        const { heading, paras, items } = resolveProse(block.base, block.paragraphs, block.list, block.listKey);
        return (
          <div data-reveal style={`--reveal-delay: ${i * 60}ms`} class="mt-12 first:mt-0">
            {heading && <h2 class="text-h2 font-semibold tracking-tight text-ink">{heading}</h2>}
            {paras.map((p) => (
              <p class="mt-5 text-lead leading-relaxed text-ink-muted">{p}</p>
            ))}
            {items.length > 0 && (
              <ul class="mt-5 space-y-3">
                {items.map((item) => (
                  <li class="flex items-start gap-3">
                    <svg class="mt-1.5 h-5 w-5 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                    <span class="text-ink-muted">{item}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        );
      })}

      {charts.length > 0 && (
        <div data-reveal class="mt-12 space-y-8">
          {charts.map((c) => (
            <figure class="rounded-2xl border border-line glass p-5">
              <figcaption>
                <h3 class="text-base font-semibold text-ink">{c.title}</h3>
                {c.caption && <p class="mt-1 text-sm text-ink-muted">{c.caption}</p>}
              </figcaption>
              <div class="mt-4">
                <Chart client:visible type={c.type} data={c.data} title={c.title} height={340} />
              </div>
            </figure>
          ))}
        </div>
      )}

      <div data-reveal class="mt-16 rounded-2xl border border-line glass p-8">
        <h2 class="text-h3 font-semibold text-ink">{t('blog.hero.title')}</h2>
        <p class="mt-3 text-ink-muted">{t('blog.hero.subtitle')}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <Button href={bookingUrl(locale)} target="_blank" rel="noopener" size="lg">{t('hero.cta.primary')}</Button>
          <Button href={localizePath(locale, '/blog')} variant="secondary" size="lg">{t('blog.hero.title')}</Button>
        </div>
      </div>
    </article>
  </section>

  {faqs.length > 0 && (
    <section class="container-page pb-24">
      <h2 data-reveal class="text-h2 font-bold tracking-tight text-ink">
        <span class="text-gradient-brand">{faqsTitle}</span>
      </h2>
      <div data-reveal class="mt-8 max-w-measure divide-y divide-line overflow-hidden rounded-2xl border border-line glass">
        {faqs.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6 text-lg font-semibold text-ink [&::-webkit-details-marker]:hidden">
              <span>{f.q}</span>
              <svg class="h-5 w-5 shrink-0 text-ink-muted transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </summary>
            <p class="px-6 pb-6 text-ink-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  <RelatedLinks items={blogRelated[post.slug] ?? []} />
</BaseLayout>
