---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import { sceneFor } from '@/data/sceneMap';
import Button from '@/components/ui/Button.astro';
import Chart from '@/components/islands/Chart';
import { asLocale, useTranslations, localizePath, getDict } from '@/i18n';
import { getCaseStudy } from '@/data/caseStudies';
import { caseStudyCharts } from '@/data/caseStudyCharts';
import { localizeChart } from '@/lib/localizeChart';
import { breadcrumb, SITE, ORG_ID, ogImageUrl, isoDateTime } from '@/seo/schema';
import { bookingUrl } from '@/lib/links';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import RelatedLinks from '@/components/ui/RelatedLinks.astro';
import { caseStudyRelated } from '@/data/related';
import Explainer from '@/components/explainers/Explainer.astro';
import { caseStudyExplainers } from '@/data/explainers';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const cs = getCaseStudy(slug);
if (!cs) throw new Error(`Unknown case study slug: ${slug}`);

const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);
const path = `/case-studies/${cs.slug}`;
const abs = (p: string) => SITE + localizePath(locale, p);
const ogImg = ogImageUrl(localizePath(locale, path));

/**
 * All studies are i18n-backed — flat dot keys under `caseStudyDetail.studies.<slug>.*`
 * (approach.N, results.N — read sequentially, so a study states only what it can
 * evidence). Exposes: challenge, approach[], solution, results[],
 * plus the context band (industry/region/focus) and SEO keywords[].
 */
/** Sequential `<key>.0`, `.1`, … until the first missing key (t() returns the key on a miss). */
const idx = (key: string, max = 8): string[] => {
  const out: string[] = [];
  for (let i = 0; i < max; i++) {
    const k = `caseStudyDetail.studies.${slug}.${key}.${i}`;
    const v = t(k);
    if (v === k) break;
    out.push(v);
  }
  return out;
};

const study = {
  title: t(`caseStudyDetail.studies.${slug}.title`),
  meta: t(`caseStudyDetail.studies.${slug}.meta`),
  industry: t(`caseStudyDetail.studies.${slug}.industry`),
  region: t(`caseStudyDetail.studies.${slug}.region`),
  focus: t(`caseStudyDetail.studies.${slug}.focus`),
  challenge: t(`caseStudyDetail.studies.${slug}.challenge`),
  approach: idx('approach'),
  solution: t(`caseStudyDetail.studies.${slug}.solution`),
  results: idx('results'),
  cta: t(`caseStudyDetail.studies.${slug}.cta`),
  keywords: t(`caseStudyDetail.studies.${slug}.keywords`)
    .split(',')
    .map((s) => s.trim())
    .filter(Boolean),
};

/** At-a-glance context chips (label + value). */
const facts = [
  { label: t('caseStudyDetail.labels.industry'), value: study.industry },
  { label: t('caseStudyDetail.labels.region'), value: study.region },
  { label: t('caseStudyDetail.labels.focus'), value: study.focus },
].filter((f) => f.value && f.value.length > 0);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: study.title,
  description: study.meta,
  about: study.challenge,
  ...(study.industry ? { articleSection: study.industry } : {}),
  ...(study.keywords && study.keywords.length ? { keywords: study.keywords.join(', ') } : {}),
  author: { '@id': ORG_ID },
  publisher: { '@id': ORG_ID },
  datePublished: isoDateTime(cs.date),
  dateModified: isoDateTime(cs.updatedAt ?? cs.date),
  inLanguage: locale === 'fr-fr' ? 'fr' : 'en',
  image: ogImg,
  url: abs(path),
};
const crumbItems = [
  { name: t('nav.home'), url: abs('/') },
  { name: t('nav.caseStudies'), url: abs('/case-studies') },
  { name: study.title, url: abs(path) },
];
const crumbs = breadcrumb(crumbItems);

/** Charts exist only for the two data-heavy evidence studies; undefined → [] otherwise. */
const charts = (caseStudyCharts[slug] ?? []).map((c) => localizeChart(t, c));

/**
 * Headline stat band — values restate figures already published in this study's
 * results (no invented numbers). Keys are optional per study; t() returns the
 * key string on a miss, which ends the loop.
 */
const stats: { value: string; label: string }[] = [];
for (let i = 0; i < 4; i++) {
  const v = t(`caseStudyDetail.studies.${slug}.stats.${i}.value`);
  const l = t(`caseStudyDetail.studies.${slug}.stats.${i}.label`);
  if (v === `caseStudyDetail.studies.${slug}.stats.${i}.value` || l === `caseStudyDetail.studies.${slug}.stats.${i}.label`) break;
  stats.push({ value: v, label: l });
}

/**
 * Optional honesty note (e.g. "representative engagement — figures illustrative",
 * or "industry evidence report — sources cited"). Looked up on the merged
 * dictionary so a missing key renders nothing rather than the key string.
 */
const note = getDict(locale)[`caseStudyDetail.studies.${slug}.note`] ?? '';

/** Optional eyebrow badge (e.g. "Evidence report · Industry analysis"); falls back to the section name. */
const badge = getDict(locale)[`caseStudyDetail.studies.${slug}.badge`] ?? t('nav.caseStudies');

/** Optional cited sources (`sources.N.label` + `sources.N.url`), read until the first gap. */
/** Optional FAQ (`faqs.N.{question,answer}`), rendered visibly and emitted as FAQPage schema. */
const faqs: { q: string; a: string }[] = [];
for (let i = 0; i < 12; i++) {
  const q = getDict(locale)[`caseStudyDetail.studies.${slug}.faqs.${i}.question`];
  const a = getDict(locale)[`caseStudyDetail.studies.${slug}.faqs.${i}.answer`];
  if (!q || !a) break;
  faqs.push({ q, a });
}
const faqLd = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      '@id': `${abs(path)}#faq`,
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }
  : null;

const sources: { label: string; url: string }[] = [];
for (let i = 0; i < 40; i++) {
  const label = getDict(locale)[`caseStudyDetail.studies.${slug}.sources.${i}.label`];
  const url = getDict(locale)[`caseStudyDetail.studies.${slug}.sources.${i}.url`];
  if (!label || !url) break;
  sources.push({ label, url });
}

/**
 * Long-form blocks, all optional and read on the merged dictionary so a study
 * without them renders exactly as before:
 *  - `pillars.N.{title,job,how,algorithms.M,players,limits}` — one technical section each
 *    (sub-headings are shared, or the study's own `labels.*`);
 *  - `orchestration.{title,body,steps.N}` — how the pillars are driven together;
 *  - `claims.N.{claim,source,verdict}` — popular figures set against their sources.
 * A study that has pillars also gets a contents list and section anchors.
 */
const dict = getDict(locale);
const sk = (key: string) => dict[`caseStudyDetail.studies.${slug}.${key}`];
const seq = (key: string, max: number): string[] => {
  const out: string[] = [];
  for (let i = 0; i < max; i++) {
    const v = sk(`${key}.${i}`);
    if (!v) break;
    out.push(v);
  }
  return out;
};
const explainers = caseStudyExplainers[slug];
/** A study may rename the fixed pillar sub-headings (`labels.{job,algorithms,players,limits}`) where the shared wording does not fit its subject. */
const pl = (k: 'job' | 'how' | 'algorithms' | 'players' | 'limits') => sk(`labels.${k}`) ?? t(`caseStudyDetail.pillar.${k}`);

const pillars: { id: string; title: string; job?: string; how: string; algorithms: string[]; players?: string; limits?: string }[] = [];
for (let i = 0; i < 8; i++) {
  const title = sk(`pillars.${i}.title`);
  const how = sk(`pillars.${i}.how`);
  if (!title || !how) break;
  pillars.push({
    id: `pillar-${i + 1}`,
    title,
    job: sk(`pillars.${i}.job`),
    how,
    algorithms: seq(`pillars.${i}.algorithms`, 10),
    players: sk(`pillars.${i}.players`),
    limits: sk(`pillars.${i}.limits`),
  });
}

const orchTitle = sk('orchestration.title');
const orchBody = sk('orchestration.body');
const orchestration = orchTitle && orchBody ? { title: orchTitle, body: orchBody, steps: seq('orchestration.steps', 8) } : null;

const claims: { claim: string; source: string; verdict: string }[] = [];
for (let i = 0; i < 24; i++) {
  const claim = sk(`claims.${i}.claim`);
  const source = sk(`claims.${i}.source`);
  const verdict = sk(`claims.${i}.verdict`);
  if (!claim || !source || !verdict) break;
  claims.push({ claim, source, verdict });
}

const longForm = pillars.length > 0;
/** Anchor ids exist only on long-form studies, so the short ones keep their markup. */
const anchor = (id: string) => (longForm ? id : undefined);
const contents = longForm
  ? [
      ...pillars.map((p) => ({ href: `#${p.id}`, label: p.title })),
      ...(orchestration ? [{ href: '#orchestration', label: orchestration.title }] : []),
      ...(claims.length ? [{ href: '#claims', label: t('caseStudyDetail.sections.claims') }] : []),
      ...(faqs.length ? [{ href: '#faq', label: t('caseStudyDetail.sections.faq') }] : []),
      ...(sources.length ? [{ href: '#sources', label: t('caseStudyDetail.sections.sources') }] : []),
    ]
  : [];
---

<BaseLayout title={getDict(locale)[`caseStudyDetail.studies.${slug}.seoTitle`] ?? study.title} description={getDict(locale)[`caseStudyDetail.studies.${slug}.seoDescription`] ?? study.meta} path={path} ogType="article" image={ogImg} jsonLd={[articleLd, crumbs, ...(faqLd ? [faqLd] : [])]}>
  <div class="reading-progress" aria-hidden="true"></div>
  <Breadcrumbs items={crumbItems} />
  <PageHeader eyebrow={badge} title={study.title} lead={study.meta} scene={sceneFor('case-study', cs.slug)} />

  {facts.length > 0 && (
    <section class="container-page">
      <dl data-reveal class="flex flex-wrap gap-3">
        {facts.map((f) => (
          <div class="rounded-xl border border-line glass px-4 py-2.5">
            <dt class="text-[11px] font-semibold uppercase tracking-wider text-ink-subtle">{f.label}</dt>
            <dd class="mt-0.5 text-sm font-medium text-ink">{f.value}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  {stats.length > 0 && (
    <section class="container-page pt-10">
      <div class:list={['grid gap-4', stats.length === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-3']}>
        {stats.map((s, i) => (
          <div
            data-reveal
            class="rounded-2xl border border-line glass p-6 text-center"
            style={`--reveal-delay: ${i * 70}ms`}
          >
            {/* Counts up to the figure as written; values that are not plain figures are left alone (src/lib/countUp.ts). */}
            <div data-countup class="text-gradient-brand text-4xl font-bold tracking-tight tabular-nums">{s.value}</div>
            <div class="mt-2 text-sm text-ink-muted">{s.label}</div>
          </div>
        ))}
      </div>
    </section>
  )}

  {note && (
    <section class="container-page pt-4">
      <p data-reveal class="rounded-xl border border-line/70 bg-surface-2/40 px-4 py-3 text-xs leading-relaxed text-ink-subtle" role="note">
        {note}
      </p>
    </section>
  )}

  {contents.length > 0 && (
    <nav class="container-page pt-10" aria-label={t('caseStudyDetail.sections.contents')}>
      <div data-reveal class="rounded-2xl border border-line glass p-6">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-ink-subtle">{t('caseStudyDetail.sections.contents')}</h2>
        <ol class="mt-4 grid gap-x-8 gap-y-2 text-sm sm:grid-cols-2">
          {contents.map((c, i) => (
            <li class="flex gap-3">
              <span class="font-mono text-xs leading-5 text-ink-subtle">{i + 1}</span>
              <a href={c.href} class="text-ink-muted underline-offset-4 hover:text-ink hover:underline">{c.label}</a>
            </li>
          ))}
        </ol>
      </div>
    </nav>
  )}

  <section class="container-page py-16">
    <div class="grid gap-12 lg:grid-cols-[1.5fr_1fr]">
      <div data-reveal>
        <h2 class="text-h3 font-semibold text-ink">{t('caseStudyDetail.sections.challenge')}</h2>
        <p class="mt-4 text-lead text-ink-muted">{study.challenge}</p>

        <h2 class="mt-12 text-h3 font-semibold text-ink">{t('caseStudyDetail.sections.solution')}</h2>
        <p class="mt-4 text-lead text-ink-muted">{study.solution}</p>

        {study.approach.length > 0 && study.approach[0] && (
          <>
            <h2 class="mt-12 text-h3 font-semibold text-ink">{t('caseStudyDetail.sections.approach')}</h2>
            <ol class="mt-6 space-y-5">
              {study.approach.map((step, i) => (
                <li class="flex gap-4">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-brand/40 text-sm font-semibold text-brand">{i + 1}</span>
                  <p class="pt-1 text-ink-muted">{step}</p>
                </li>
              ))}
            </ol>
          </>
        )}
      </div>

      <aside data-reveal style="--reveal-delay: 80ms" class="h-fit rounded-2xl border border-line glass p-6 lg:sticky lg:top-24">
        <h2 class="text-h3 font-semibold text-ink">{t('caseStudyDetail.sections.results')}</h2>
        <ul class="mt-4 space-y-3">
          {study.results.map((r) => (
            <li class="flex items-start gap-3 text-sm text-ink-muted">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
              <span>{r}</span>
            </li>
          ))}
        </ul>
        {study.cta && <p class="mt-6 text-sm text-ink-subtle">{study.cta}</p>}
        <Button href={bookingUrl(locale)} target="_blank" rel="noopener" size="lg" class="mt-6 w-full">{t('caseStudyDetail.cta.button')}</Button>
      </aside>
    </div>
  </section>

  {pillars.map((p, i) => (
    <section id={p.id} class="container-page scroll-mt-24 pb-16">
      <h2 data-reveal class="text-h3 font-semibold text-ink">{p.title}</h2>
      {p.job && (
        <p data-reveal class="mt-4 max-w-measure rounded-xl border border-brand/30 bg-brand/5 px-4 py-3 text-sm text-ink-muted">
          <span class="font-semibold text-ink">{pl('job')}</span> {p.job}
        </p>
      )}
      <div class="mt-8 grid gap-10 lg:grid-cols-[1.5fr_1fr]">
        <div data-reveal>
          <h3 class="text-base font-semibold text-ink">{pl('how')}</h3>
          <p class="mt-3 text-ink-muted">{p.how}</p>
          {p.players && (
            <>
              <h3 class="mt-8 text-base font-semibold text-ink">{pl('players')}</h3>
              <p class="mt-3 text-ink-muted">{p.players}</p>
            </>
          )}
          {p.limits && (
            <>
              <h3 class="mt-8 text-base font-semibold text-ink">{pl('limits')}</h3>
              <p class="mt-3 text-ink-muted">{p.limits}</p>
            </>
          )}
        </div>
        {p.algorithms.length > 0 && (
          <aside data-reveal style="--reveal-delay: 80ms" class="h-fit rounded-2xl border border-line glass p-6">
            <h3 class="text-base font-semibold text-ink">{pl('algorithms')}</h3>
            <ul class="mt-4 space-y-3 text-sm text-ink-muted">
              {p.algorithms.map((a) => (
                <li class="flex gap-3">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true"></span>
                  <span>{a}</span>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>
      {explainers?.pillars[i] && (
        <div data-reveal class="mt-10">
          <Explainer id={explainers.pillars[i]} />
        </div>
      )}
    </section>
  ))}

  {orchestration && (
    <section id="orchestration" class="container-page scroll-mt-24 pb-16">
      <h2 data-reveal class="text-h3 font-semibold text-ink">{orchestration.title}</h2>
      <p data-reveal class="mt-4 max-w-measure text-lead text-ink-muted">{orchestration.body}</p>
      {orchestration.steps.length > 0 && (
        <ol data-reveal class="mt-8 grid gap-4 md:grid-cols-2">
          {orchestration.steps.map((step, i) => (
            <li class="flex gap-4 rounded-2xl border border-line glass p-5">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-brand/40 text-sm font-semibold text-brand">{i + 1}</span>
              <p class="pt-1 text-sm text-ink-muted">{step}</p>
            </li>
          ))}
        </ol>
      )}
      {explainers?.orchestration && (
        <div data-reveal class="mt-10">
          <Explainer id={explainers.orchestration} />
        </div>
      )}
    </section>
  )}

  {charts.length > 0 && (
    <section class="container-page pb-20">
      <div class="grid gap-6 md:grid-cols-2">
        {charts.map((c) => (
          <figure data-reveal class="rounded-2xl border border-line glass p-5">
            <figcaption>
              <h3 class="text-base font-semibold text-ink">{c.title}</h3>
              {c.caption && <p class="mt-1 text-sm text-ink-muted">{c.caption}</p>}
            </figcaption>
            <div class="mt-4">
              <Chart client:visible type={c.type} data={c.data} title={c.title} height={340} />
            </div>
          </figure>
        ))}
      </div>
    </section>
  )}

  {claims.length > 0 && (
    <section id="claims" class="container-page scroll-mt-24 pb-16">
      <h2 id="claims-title" data-reveal class="text-h3 font-semibold text-ink">{t('caseStudyDetail.sections.claims')}</h2>
      <p data-reveal class="mt-3 max-w-measure text-ink-muted">{t('caseStudyDetail.claims.intro')}</p>
      {/* Scrolls sideways on a phone, so it must be reachable from the keyboard. */}
      <div data-reveal class="mt-6 overflow-x-auto rounded-2xl border border-line glass" role="region" tabindex="0" aria-labelledby="claims-title">
        <table class="w-full min-w-[640px] text-left text-sm">
          <thead class="text-xs uppercase tracking-wider text-ink-subtle">
            <tr>
              <th scope="col" class="p-4 font-semibold">{t('caseStudyDetail.claims.claim')}</th>
              <th scope="col" class="p-4 font-semibold">{t('caseStudyDetail.claims.source')}</th>
              <th scope="col" class="p-4 font-semibold">{t('caseStudyDetail.claims.verdict')}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line text-ink-muted">
            {claims.map((c) => (
              <tr>
                <th scope="row" class="p-4 align-top font-medium text-ink">{c.claim}</th>
                <td class="p-4 align-top">{c.source}</td>
                <td class="p-4 align-top font-medium text-ink">{c.verdict}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {faqs.length > 0 && (
    <section id={anchor('faq')} class:list={['container-page pb-4', longForm && 'scroll-mt-24']}>
      <h2 data-reveal class="text-h3 font-semibold text-ink">{t('caseStudyDetail.sections.faq')}</h2>
      <div data-reveal class="mt-6 max-w-measure divide-y divide-line overflow-hidden rounded-2xl border border-line glass">
        {faqs.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6 text-base font-semibold text-ink [&::-webkit-details-marker]:hidden">
              <span>{f.q}</span>
              <span aria-hidden="true" class="shrink-0 text-ink-subtle transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="px-6 pb-6 text-ink-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  {sources.length > 0 && (
    <section id={anchor('sources')} class:list={['container-page pb-4', longForm && 'scroll-mt-24']}>
      <h2 data-reveal class="text-h3 font-semibold text-ink">{t('caseStudyDetail.sections.sources')}</h2>
      <ol data-reveal class="mt-4 grid gap-2 text-sm text-ink-muted sm:grid-cols-2">
        {sources.map((src, i) => (
          <li class="flex min-w-0 gap-2">
            <span class="w-6 shrink-0 font-mono text-xs text-ink-subtle">[{i + 1}]</span>
            {/* A DOI is one long unbreakable word: let it wrap, or it widens the page on a phone. */}
            <a href={src.url} target="_blank" rel="noopener nofollow" class="min-w-0 break-words underline-offset-4 hover:text-ink hover:underline">{src.label}</a>
          </li>
        ))}
      </ol>
    </section>
  )}

  <RelatedLinks items={caseStudyRelated[slug] ?? []} />
</BaseLayout>

<script>
  import { armCountUps } from '@/lib/countUp';
  import { motionOff } from '@/lib/motion';

  function setupStats() {
    if (motionOff()) return; // the figures stand as written
    const teardown = armCountUps();
    document.addEventListener('astro:before-swap', teardown, { once: true });
  }
  document.addEventListener('astro:page-load', setupStats);
  /* Initialize immediately if astro:page-load already fired before this module ran */
  if (document.readyState !== 'loading') setupStats();
</script>
