---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import Button from '@/components/ui/Button.astro';
import { asLocale, useTranslations, localizePath } from '@/i18n';
import { getService, localizeService } from '@/data/services';
import { breadcrumb, SITE, ORG_ID, ogImageUrl, imageObject } from '@/seo/schema';
import { bookingUrl } from '@/lib/links';
import BlueprintFigure from '@/components/ui/BlueprintFigure.astro';
import BlueprintArt from '@/components/ui/BlueprintArt.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import RelatedLinks from '@/components/ui/RelatedLinks.astro';
import { consoles } from '@/components/ui/consoles';
import { serviceVisuals } from '@/data/visuals';
import { serviceRelated } from '@/data/related';
import { getCaseStudy } from '@/data/caseStudies';
import StackGrid from '@/components/ui/StackGrid.astro';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const svc = getService(slug);
if (!svc) throw new Error(`Unknown service slug: ${slug}`);
/** Living console — visually replaces the static SVG (which stays on disk for the
 *  image sitemap / ImageObject / no-JS fallback). */
const Console = consoles[svc.console];
if (!Console) throw new Error(`No console registered for ${svc.slug} (${svc.console})`);

const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);
/** Localized catalogue copy (name/tagline/summary/capabilities/outcomes). */
const loc = localizeService(t, svc);
const path = `/services/${svc.slug}`;
const abs = (p: string) => SITE + localizePath(locale, p);
const ogImg = ogImageUrl(localizePath(locale, path));
const svcVisual = serviceVisuals[svc.slug];
const svcVisualAlt = svcVisual ? t(svcVisual.altKey) : '';

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: loc.name,
  description: loc.summary,
  provider: { '@id': ORG_ID },
  areaServed: [
    { '@type': 'Country', name: 'Australia' },
    { '@type': 'Country', name: 'France' },
  ],
  image: svcVisual
    ? [ogImg, imageObject({ path: svcVisual.file, alt: svcVisualAlt, width: svcVisual.width, height: svcVisual.height, primary: true })]
    : ogImg,
  url: abs(path),
};
const crumbItems = [
  { name: t('nav.home'), url: abs('/') },
  { name: t('nav.services'), url: abs('/services') },
  { name: loc.name, url: abs(path) },
];
const crumbs = breadcrumb(crumbItems);

/**
 * FAQs — rendered visibly AND emitted as FAQPage schema (Google requires the
 * structured data to match on-page content). Counts vary per service; we read
 * sequential keys until one is missing (t() returns the key string on a miss).
 */
const ns = svc.ns;
/** Dark-blueprint illustration for this service (shared with the homepage showcase). */
const bpArt = svc.blueprint;
// Localized meta/header copy where the dictionary has it; catalogue EN as fallback
// (t() returns the key string on a miss).
const tOr = (key: string, fallback: string) => {
  const v = t(key);
  return v === key ? fallback : v;
};
const metaTitle = ns ? tOr(`${ns}.meta.title`, loc.name) : loc.name;
const metaDescription = ns ? tOr(`${ns}.meta.description`, loc.summary) : loc.summary;
const heroLead = ns ? tOr(`${ns}.hero.subtitle`, loc.tagline) : loc.tagline;
const faqsTitle = ns ? tOr(`${ns}.faqs.title`, t('services.detail.faqTitle')) : t('services.detail.faqTitle');
/** "How it works" — sequential `${ns}.steps.N.{title,desc}` (up to 6). */
const steps: { title: string; desc: string }[] = [];
for (let i = 0; i < 6; i++) {
  const title = t(`${ns}.steps.${i}.title`);
  const desc = t(`${ns}.steps.${i}.desc`);
  if (title === `${ns}.steps.${i}.title` || desc === `${ns}.steps.${i}.desc`) break;
  steps.push({ title, desc });
}

/** "In practice" — the registry's explicitly chosen case study (hidden when null). */
const proofStudy = svc.proof ? getCaseStudy(svc.proof) : undefined;
if (svc.proof && !proofStudy) throw new Error(`Unknown proof case study for ${svc.slug}: ${svc.proof}`);
const proof = proofStudy
  ? {
      href: localizePath(locale, `/case-studies/${proofStudy.slug}`),
      title: t(`caseStudyDetail.studies.${proofStudy.slug}.title`),
      industry: t(`caseStudyDetail.studies.${proofStudy.slug}.industry`),
      challenge: t(`caseStudies.items.${proofStudy.i18nIndex}.challenge`),
      // Evidence label shown with the card: the study's badge, else its note.
      label: tOr(`caseStudyDetail.studies.${proofStudy.slug}.badge`, tOr(`caseStudyDetail.studies.${proofStudy.slug}.note`, '')),
    }
  : null;

const faqNs = ns;
const faqs: { q: string; a: string }[] = [];
if (faqNs) {
  for (let i = 0; i < 12; i++) {
    const q = t(`${faqNs}.faqs.${i}.question`);
    const a = t(`${faqNs}.faqs.${i}.answer`);
    if (q === `${faqNs}.faqs.${i}.question` || a === `${faqNs}.faqs.${i}.answer`) break;
    faqs.push({ q, a });
  }
}
const faqLd = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      '@id': `${SITE}${localizePath(locale, path)}#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<BaseLayout title={metaTitle} description={metaDescription} path={path} image={ogImg} jsonLd={[serviceLd, crumbs, ...(faqLd ? [faqLd] : [])]}>
  <Breadcrumbs items={crumbItems} />
  <PageHeader eyebrow={t('nav.services')} title={loc.name} lead={heroLead} />

  {svcVisual && (
    <section class="container-page pt-12">
      <Console />
    </section>
  )}

  <section class="container-page py-20">
    <div class="grid gap-12 lg:grid-cols-[1.5fr_1fr]">
      <div data-reveal>
        <p class="text-lead text-ink-muted">{loc.summary}</p>

        <h2 class="mt-12 text-h3 font-semibold text-ink">{tOr('services.detail.included', "What's included")}</h2>
        <ul class="mt-5 space-y-3">
          {loc.capabilities.map((c) => (
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
              <span class="text-ink-muted">{c}</span>
            </li>
          ))}
        </ul>
      </div>

      <aside data-reveal style="--reveal-delay: 80ms" class="h-fit space-y-6">
        <BlueprintFigure fig={bpArt.fig} class="aspect-[4/3]">
          <BlueprintArt kind={bpArt.kind} class="mx-auto block h-full w-full p-5" />
        </BlueprintFigure>
        <div class="rounded-2xl border border-line glass p-6">
        <h2 class="text-h3 font-semibold text-ink">{tOr('services.detail.outcomes', 'Outcomes')}</h2>
        <ul class="mt-4 space-y-3">
          {loc.outcomes.map((o) => (
            <li class="flex items-start gap-3 text-sm text-ink-muted">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
              {o}
            </li>
          ))}
        </ul>
          <Button href={bookingUrl(locale)} target="_blank" rel="noopener" size="lg" class="mt-8 w-full">{t('hero.cta.primary')}</Button>
        </div>
      </aside>
    </div>
  </section>

  {steps.length > 0 && (
    <section class="container-page pb-20" aria-labelledby="how-it-works" data-steps>
      <div data-reveal class="max-w-2xl">
        <h2 id="how-it-works" class="text-h2 font-bold tracking-tight text-ink">{t('services.detail.howItWorks')}</h2>
        <p class="mt-3 text-ink-muted">{t('services.detail.howItWorksLead')}</p>
      </div>
      <ol class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 60}ms`} class="relative rounded-2xl border border-line glass p-6">
            <span class="font-mono text-xs tracking-[0.16em] text-brand" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="sr-only">{t('services.detail.stepLabel')} {i + 1}:</span>
            <h3 class="mt-3 text-lg font-semibold text-ink">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">{s.desc}</p>
          </li>
        ))}
      </ol>
    </section>
  )}

  {svc.stack.length > 0 && (
    <section class="container-page pb-20" aria-labelledby="stack">
      <div data-reveal class="max-w-2xl">
        <h2 id="stack" class="text-h2 font-bold tracking-tight text-ink">{t('services.detail.stack')}</h2>
        <p class="mt-3 text-ink-muted">{t('services.detail.stackLead')}</p>
      </div>
      <StackGrid only={svc.stack} class="mt-8" />
    </section>
  )}

  {proof && (
    <section class="container-page pb-20" aria-labelledby="in-practice" data-proof>
      <h2 id="in-practice" data-reveal class="text-h2 font-bold tracking-tight text-ink">{t('services.detail.proof')}</h2>
      <a
        href={proof.href}
        data-reveal
        class="group ring-gradient mt-8 block rounded-2xl border border-line glass p-6 transition-[transform,box-shadow] duration-300 ease-smooth hover:-translate-y-1 hover:shadow-glow sm:p-8"
      >
        <span class="inline-flex rounded-full border border-line px-3 py-1 font-mono text-xs uppercase tracking-[0.14em] text-ink-subtle">{proof.industry}</span>
        <h3 class="mt-4 text-h3 font-semibold text-ink">{proof.title}</h3>
        <p class="mt-3 max-w-3xl text-ink-muted">{proof.challenge}</p>
        {proof.label && <p class="mt-4 max-w-3xl text-sm text-ink-subtle">{proof.label}</p>}
        <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand">
          {t('services.detail.proofCta')}
          <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </span>
      </a>
    </section>
  )}

  {faqs.length > 0 && (
    <section class="container-page pb-24">
      <h2 data-reveal class="text-h2 font-bold tracking-tight text-ink">
        <span class="text-gradient-brand">{faqsTitle}</span>
      </h2>
      <div data-reveal class="mt-8 max-w-measure divide-y divide-line overflow-hidden rounded-2xl border border-line glass">
        {faqs.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6 text-lg font-semibold text-ink [&::-webkit-details-marker]:hidden">
              <span>{f.q}</span>
              <svg class="h-5 w-5 shrink-0 text-ink-muted transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </summary>
            <p class="px-6 pb-6 text-ink-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  <RelatedLinks items={serviceRelated[svc.slug] ?? []} />
</BaseLayout>
