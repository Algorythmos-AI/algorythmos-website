---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import Button from '@/components/ui/Button.astro';
import { asLocale, useTranslations, localizePath } from '@/i18n';
import { getService } from '@/data/services';
import { breadcrumb, SITE, ORG_ID, ogImageUrl } from '@/seo/schema';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const svc = getService(slug);
if (!svc) throw new Error(`Unknown service slug: ${slug}`);

const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);
const path = `/services/${svc.slug}`;
const abs = (p: string) => SITE + localizePath(locale, p);
const ogImg = ogImageUrl(localizePath(locale, path));

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: svc.name,
  description: svc.summary,
  provider: { '@id': ORG_ID },
  areaServed: [
    { '@type': 'Country', name: 'Australia' },
    { '@type': 'Country', name: 'France' },
  ],
  image: ogImg,
  url: abs(path),
};
const crumbs = breadcrumb([
  { name: 'Home', url: abs('/') },
  { name: t('nav.services'), url: abs('/services') },
  { name: svc.name, url: abs(path) },
]);
---

<BaseLayout title={`${svc.name} — Algorythmos`} description={svc.summary} path={path} image={ogImg} jsonLd={[serviceLd, crumbs]}>
  <PageHeader eyebrow={t('nav.services')} title={svc.name} lead={svc.tagline} />

  <section class="container-page py-20">
    <div class="grid gap-12 lg:grid-cols-[1.5fr_1fr]">
      <div data-reveal>
        <p class="text-lead text-ink-muted">{svc.summary}</p>

        <h2 class="mt-12 text-h3 font-semibold text-ink">What's included</h2>
        <ul class="mt-5 space-y-3">
          {svc.capabilities.map((c) => (
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
              <span class="text-ink-muted">{c}</span>
            </li>
          ))}
        </ul>
      </div>

      <aside data-reveal style="--reveal-delay: 80ms" class="h-fit rounded-2xl border border-line glass p-6">
        <h2 class="text-h3 font-semibold text-ink">Outcomes</h2>
        <ul class="mt-4 space-y-3">
          {svc.outcomes.map((o) => (
            <li class="flex items-start gap-3 text-sm text-ink-muted">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
              {o}
            </li>
          ))}
        </ul>
        <Button href={localizePath(locale, '/contact')} size="lg" class="mt-8 w-full">{t('hero.cta.primary')}</Button>
      </aside>
    </div>
  </section>
</BaseLayout>
