---
import { asLocale, useTranslations, localizePath } from '@/i18n';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import MotionToggle from '@/components/ui/MotionToggle.astro';
import LocaleSwitcher from '@/components/layout/LocaleSwitcher.astro';
import Button from '@/components/ui/Button.astro';

const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);
const here = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { key: 'nav.services', path: '/services' },
  { key: 'nav.caseStudies', path: '/case-studies' },
  { key: 'nav.blog', path: '/blog' },
  { key: 'nav.pricing', path: '/pricing' },
  { key: 'nav.about', path: '/about' },
];

const isActive = (path: string) => {
  const target = localizePath(locale, path).replace(/\/$/, '') || '/';
  return here === target || (path !== '/' && here.startsWith(target + '/'));
};
const home = localizePath(locale, '/');
const contact = localizePath(locale, '/contact');
---

<header
  data-header
  class="group sticky top-0 z-[var(--z-nav)] border-b border-line/80 bg-bg/80 backdrop-blur-xl transition-[background-color,border-color,box-shadow] duration-300 ease-smooth data-[scrolled]:border-line data-[scrolled]:bg-bg/95 data-[scrolled]:shadow-e2"
>
  <div class="container-page flex h-16 items-center justify-between gap-6 transition-[height] duration-300 ease-smooth group-data-[scrolled]:h-14">
    <a href={home} class="group/logo flex items-center gap-2.5 text-lg font-bold tracking-tight text-ink" aria-label={t('ui.homeLink')}>
      <img src="/logo-mark.png" alt="" aria-hidden="true" width="218" height="258" class="h-8 w-auto transition-transform duration-300 ease-bounce-soft group-hover/logo:scale-105" />
      <span>Algoryth<span class="text-gradient-brand">mos</span></span>
    </a>

    <nav class="nav-spotlight relative hidden items-center gap-1 md:flex" aria-label="Primary" data-magic-nav>
      {nav.map((item) => (
        <a
          href={localizePath(locale, item.path)}
          class:list={[
            'nav-link rounded-md px-3 py-2 text-[13px] font-semibold uppercase tracking-[0.08em] transition-colors hover:text-ink',
            isActive(item.path) ? 'text-ink' : 'text-ink-muted',
          ]}
          aria-current={isActive(item.path) ? 'page' : undefined}
        >
          {t(item.key)}
        </a>
      ))}
      {/* Magic line — single sliding gradient indicator shared by all links */}
      <span class="magic-line" aria-hidden="true"></span>
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden lg:block"><LocaleSwitcher compact /></div>
      <MotionToggle />
      <ThemeToggle />
      <Button href={contact} size="md" class="cta-arrow hidden transition-transform hover:-translate-y-px sm:inline-flex">
        {t('nav.contactUs')}
        <span class="cta-arrow-glyph" aria-hidden="true">→</span>
      </Button>

      {/* Mobile disclosure menu — no JS required */}
      <details data-mobile-menu class="md:hidden [&_svg.close]:hidden [&[open]_svg.open]:hidden [&[open]_svg.close]:block">
        <summary
          class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-line text-ink-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-bg [&::-webkit-details-marker]:hidden"
          aria-label={t('ui.openMenu')}
          data-label-open={t('ui.openMenu')}
          data-label-close={t('ui.closeMenu')}
        >
          <svg class="open h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg class="close h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </summary>
        <div class="menu-panel absolute inset-x-0 top-16 border-b border-line bg-bg/95 backdrop-blur-xl group-data-[scrolled]:top-14">
          <nav class="container-page flex flex-col gap-1 py-4" aria-label="Mobile">
            {nav.map((item) => (
              <a href={localizePath(locale, item.path)} class="rounded-md px-3 py-3 text-base font-medium text-ink-muted hover:bg-surface-2 hover:text-ink" aria-current={isActive(item.path) ? 'page' : undefined}>{t(item.key)}</a>
            ))}
            <Button href={contact} size="lg" class="mt-2">{t('nav.contactUs')}</Button>
            <div class="mt-4 border-t border-line pt-4"><LocaleSwitcher /></div>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  /* Scroll-aware condensing with hysteresis (add >12px, remove <4px) to avoid threshold jitter.
     rAF-throttled passive listener; re-bound per navigation, torn down on view-transition swap. */
  function setupHeaderScroll() {
    const header = document.querySelector('[data-header]');
    if (!header || (header as HTMLElement).dataset.scrollInit) return;
    (header as HTMLElement).dataset.scrollInit = '1';
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = window.scrollY;
      if (y > 12) header.setAttribute('data-scrolled', '');
      else if (y < 4) header.removeAttribute('data-scrolled');
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener(
      'astro:before-swap',
      () => window.removeEventListener('scroll', onScroll),
      { once: true },
    );
    update();
  }
  document.addEventListener('astro:page-load', setupHeaderScroll);
  /* Initialize immediately if astro:page-load already fired before this module ran */
  if (document.readyState !== 'loading') setupHeaderScroll();

  /* Magic line — one gradient indicator that glides between nav links on
     hover/focus and rests on the current page's link. Measures only on
     interaction/resize/font-load; torn down on view-transition swaps. */
  function setupMagicLine() {
    const nav = document.querySelector('[data-magic-nav]');
    if (!(nav instanceof HTMLElement) || nav.dataset.magicInit) return;
    nav.dataset.magicInit = '1';
    const line = nav.querySelector('.magic-line');
    if (!(line instanceof HTMLElement)) return;

    const links = Array.from(nav.querySelectorAll('a'));
    const active = nav.querySelector('a[aria-current="page"]');

    const moveTo = (el: Element | null, rest: boolean) => {
      /* Nav is display:none below md — offsetWidth 0; skip until it's laid out */
      if (!(el instanceof HTMLElement) || !el.offsetWidth) {
        line.style.opacity = '0';
        return;
      }
      line.style.transform = `translateX(${el.offsetLeft}px)`;
      line.style.width = `${el.offsetWidth - 16}px`; /* inset by the link's px-3 padding-ish */
      line.style.marginLeft = '8px';
      line.style.opacity = rest ? '0.45' : '1';
    };
    const settle = () => moveTo(active, true);

    links.forEach((a) => {
      a.addEventListener('mouseenter', () => moveTo(a, false));
      a.addEventListener('focusin', () => moveTo(a, false));
    });
    nav.addEventListener('mouseleave', settle);
    nav.addEventListener('focusout', (e) => {
      if (!nav.contains(e.relatedTarget as Node | null)) settle();
    });

    /* Rest on the active link once metrics are final (variable font swap shifts widths) */
    let settleTimer = 0;
    const scheduleSettle = () => {
      window.clearTimeout(settleTimer);
      settleTimer = window.setTimeout(settle, 80);
    };
    if (document.fonts?.ready) document.fonts.ready.then(scheduleSettle);
    scheduleSettle();

    const ro = new ResizeObserver(scheduleSettle);
    ro.observe(nav);

    document.addEventListener(
      'astro:before-swap',
      () => {
        ro.disconnect();
        window.clearTimeout(settleTimer);
      },
      { once: true },
    );
  }
  document.addEventListener('astro:page-load', setupMagicLine);
  if (document.readyState !== 'loading') setupMagicLine();

  /* Mobile menu: label reflects state, Escape and outside-click close it. */
  function setupMobileMenu() {
    const details = document.querySelector('[data-mobile-menu]');
    if (!(details instanceof HTMLDetailsElement) || details.dataset.menuInit) return;
    details.dataset.menuInit = '1';
    const summary = details.querySelector('summary');
    const sync = () => {
      if (!(summary instanceof HTMLElement)) return;
      const open = details.open;
      summary.setAttribute('aria-label', (open ? summary.dataset.labelClose : summary.dataset.labelOpen) || '');
      summary.setAttribute('aria-expanded', String(open));
    };
    details.addEventListener('toggle', sync);
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && details.open) {
        details.open = false;
        (summary as HTMLElement | null)?.focus();
      }
    };
    const onClick = (e: MouseEvent) => {
      if (details.open && !details.contains(e.target as Node)) details.open = false;
    };
    document.addEventListener('keydown', onKey);
    document.addEventListener('click', onClick);
    document.addEventListener(
      'astro:before-swap',
      () => {
        document.removeEventListener('keydown', onKey);
        document.removeEventListener('click', onClick);
      },
      { once: true },
    );
    sync();
  }
  document.addEventListener('astro:page-load', setupMobileMenu);
  if (document.readyState !== 'loading') setupMobileMenu();
</script>
