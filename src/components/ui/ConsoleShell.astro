---
/**
 * ConsoleShell — frame + scaled fixed-canvas viewport for the living product
 * consoles. The screen content (slot) is authored at a native pixel size
 * (e.g. 1280×800) and scaled to fit the container, so the composition is
 * pixel-faithful at every width and FR copy fits deterministically.
 *
 * Scaling strategy (crisp text, bulletproof cross-browser):
 *  - Desktop/tablet: a JS-measured NUMERIC `--hc-scale` (clientWidth ÷ canvas)
 *    fed to `zoom` — `zoom` re-lays-out so text rasterizes crisp at any scale.
 *    (The old `calc(tan(atan2(100cqw,…)))` trick broke on iOS Safari, which
 *    couldn't resolve a container unit inside trig → invalid zoom → clip.)
 *  - Ancient Firefox (<126, no `zoom`): `transform: scale(var(--hc-scale))`.
 *  - Mobile (<768px): the media query in console.css neutralizes zoom/transform
 *    and the console reflows to a readable single column (scaler is a no-op).
 *  - No-JS / crawlers: the <noscript> <img> of the original SVG.
 *
 * The screen is hidden until the scaler adds `.hc-scaled` (no FOUC). The
 * original SVG stays on disk untouched — image-sitemap / ImageObject / llms.txt
 * asset, and the no-JS visual via <noscript>.
 *
 * A11y: the console is a *picture* of a product — role="img" with one label;
 * the screen is aria-hidden and inert (pointer-events/user-select none), and
 * console markup must never contain focusable elements.
 */
import '@/styles/console.css';
import { asLocale, useTranslations } from '@/i18n';

interface Props {
  /** Crawler/fallback asset (e.g. heroVisual.file) — must exist in public/. */
  svgFile: string;
  /** Native canvas size — single source of truth shared with visuals.ts. */
  width: number;
  height: number;
  /** i18n key for the role="img" label (reuse the existing visuals.*.alt keys). */
  altKey: string;
  revealDelay?: number;
  class?: string;
  /** Hook for the console script, e.g. 'hero-console'. Rendered as data-console. */
  name: string;
}

const { svgFile, width, height, altKey, revealDelay, class: klass = '', name } = Astro.props;
const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);
const alt = t(altKey);
---

<figure
  data-reveal="lcp"
  style={revealDelay ? `--reveal-delay: ${revealDelay}ms` : undefined}
  class:list={['hc-figure my-0', klass]}
>
  <div class="ring-gradient relative rounded-2xl border border-line glass p-2 shadow-e2 sm:p-2.5 shimmer-frame">
    <div
      class="hc-viewport"
      style={`--hc-w: ${width}px; --hc-h: ${height}px; --hc-ar: ${width} / ${height};`}
      role="img"
      aria-label={alt}
      data-console={name}
    >
      <div class="hc-screen" aria-hidden="true">
        <slot />
      </div>
      <noscript>
        <img src={svgFile} alt={alt} width={width} height={height} loading="lazy" decoding="async" class="hc-fallback" />
      </noscript>
    </div>
  </div>
</figure>

<style>
  .hc-viewport {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--hc-ar);
    border-radius: 0.75rem; /* matches Visual's rounded-xl inner */
    background: #0c0c13; /* console canvas — theme-neutral dark "screen" */
  }

  .hc-screen {
    /* Native canvas box (vars, not inline, so the mobile query can override). */
    width: var(--hc-w);
    height: var(--hc-h);
    /* --hc-scale is a plain number set by the scaler (mountConsoleScaler). */
    zoom: var(--hc-scale, 1);
    contain: layout paint; /* console animations can never invalidate page layout */
    pointer-events: none;
    user-select: none;
    visibility: hidden; /* revealed once scaled → no FOUC */
  }
  .hc-viewport.hc-scaled .hc-screen {
    visibility: visible;
  }

  /* Ancient Firefox (<126): no `zoom` — compositor scale fallback. */
  @supports not (zoom: 1) {
    .hc-screen {
      zoom: normal;
      transform: scale(var(--hc-scale, 1));
      transform-origin: top left;
    }
  }

  .hc-fallback {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Mobile: drop the scaled fixed canvas → the console reflows to a readable
     single column (per-console rules live in each console's own styles). */
  @media (max-width: 767px) {
    .hc-viewport {
      aspect-ratio: auto;
      overflow: visible;
    }
    .hc-screen {
      zoom: normal;
      transform: none;
      width: 100%;
      height: auto;
      contain: none;
      visibility: visible;
    }
  }
</style>

<script>
  import { mountConsoleScaler } from '@/lib/consoleLoop';

  function mountAll() {
    document.querySelectorAll<HTMLElement>('.hc-viewport[data-console]').forEach(mountConsoleScaler);
  }
  document.addEventListener('astro:page-load', mountAll);
  if (document.readyState !== 'loading') mountAll();
</script>
