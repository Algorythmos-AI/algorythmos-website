---
/**
 * ConsoleShell — frame + scaled fixed-canvas viewport for the living product
 * consoles. The screen content (slot) is authored at a native pixel size
 * (e.g. 1280×800) and scaled to fit the container, so the composition is
 * pixel-faithful at every width and FR copy fits deterministically.
 *
 * Scaling strategy (crisp text first):
 *  1. CSS `zoom` with a typed-math ratio — `calc(tan(atan2(100cqw, <w>px)))`
 *     yields a true <number> (length ÷ length), and `zoom` re-lays-out text so
 *     it rasterizes crisp at every scale.
 *  2. Browsers without `zoom` (old Firefox): `transform: scale(var(--hc-scale))`.
 *  3. Browsers without container-query units or CSS trig: the DOM screen is
 *     hidden and a plain lazy `<img>` of the original SVG shows instead.
 *
 * The original SVG stays on disk untouched — it remains the image-sitemap /
 * ImageObject / llms.txt asset, is served to raw-HTML crawlers via the always-
 * present fallback <img> below (hidden + loading="lazy" → modern browsers
 * never fetch it), and is the visual for the no-modern-CSS rung.
 *
 * A11y: the console is a *picture* of a product — role="img" with one label;
 * the screen is aria-hidden and inert (pointer-events/user-select none), and
 * console markup must never contain focusable elements.
 */
import { asLocale, useTranslations } from '@/i18n';

interface Props {
  /** Crawler/fallback asset (e.g. heroVisual.file) — must exist in public/. */
  svgFile: string;
  /** Native canvas size — single source of truth shared with visuals.ts. */
  width: number;
  height: number;
  /** i18n key for the role="img" label (reuse the existing visuals.*.alt keys). */
  altKey: string;
  revealDelay?: number;
  class?: string;
  /** Hook for the console script, e.g. 'hero-console'. Rendered as data-console. */
  name: string;
}

const { svgFile, width, height, altKey, revealDelay, class: klass = '', name } = Astro.props;
const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);
const alt = t(altKey);
---

<figure
  data-reveal="lcp"
  style={revealDelay ? `--reveal-delay: ${revealDelay}ms` : undefined}
  class:list={['hc-figure my-0', klass]}
>
  <div class="ring-gradient relative rounded-2xl border border-line glass p-2 shadow-e2 sm:p-2.5 shimmer-frame">
    <div
      class="hc-viewport"
      style={`--hc-w: ${width}px; aspect-ratio: ${width} / ${height};`}
      role="img"
      aria-label={alt}
      data-console={name}
    >
      <div class="hc-screen" style={`width: ${width}px; height: ${height}px;`} aria-hidden="true">
        <slot />
      </div>
      <img
        src={svgFile}
        alt={alt}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
        class="hc-fallback"
      />
    </div>
  </div>
</figure>

<style>
  .hc-viewport {
    container-type: inline-size;
    position: relative;
    overflow: hidden;
    border-radius: 0.75rem; /* matches Visual's rounded-xl inner */
    background: #0c0c13; /* console canvas — theme-neutral dark "screen" */
  }

  .hc-screen {
    /* length ÷ length via trig → a true <number> for zoom/scale */
    --hc-scale: calc(tan(atan2(100cqw, var(--hc-w))));
    zoom: var(--hc-scale);
    contain: layout paint; /* console animations can never invalidate page layout */
    pointer-events: none;
    user-select: none;
  }

  /* Old Firefox (< 126): no zoom — compositor scale fallback. */
  @supports not (zoom: 1) {
    .hc-screen {
      transform: scale(var(--hc-scale));
      transform-origin: top left;
    }
  }

  /* Fallback image: crawlers read it from HTML; hidden + lazy → modern
     browsers never fetch it. Shown only on the no-modern-CSS rung. */
  .hc-fallback {
    display: none;
    width: 100%;
    height: auto;
  }
  @supports not ((container-type: inline-size) and (top: calc(tan(atan2(1px, 1px)) * 1px))) {
    .hc-screen {
      display: none;
    }
    .hc-fallback {
      display: block;
    }
  }
</style>
