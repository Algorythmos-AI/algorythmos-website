---
/**
 * Photography renderer — responsive, CLS-proof, brand-consistent.
 *
 * Renders a real alt-tagged <img> with a 800/1200/1600w WebP srcset from the
 * `photos` manifest (src/data/visuals.ts). Always lazy (photos are supporting
 * texture, never the LCP — the SVG hero keeps that role). A subtle brand-tint
 * overlay keeps photos cohesive with the design system in both themes.
 */
import { PHOTO_WIDTHS, photoFile, type PhotoAsset } from '@/data/visuals';

interface Props {
  photo: PhotoAsset;
  alt: string;
  /** matches the layout the photo sits in; default suits a 2-col band */
  sizes?: string;
  class?: string;
  figureClass?: string;
}

const { photo, alt, sizes = '(min-width: 1024px) 50vw, 100vw', class: imgClass = '', figureClass = '' } = Astro.props;
const srcset = PHOTO_WIDTHS.map((w) => `${photoFile(photo, w)} ${w}w`).join(', ');
---

<figure class:list={['relative overflow-hidden rounded-2xl border border-line', figureClass]}>
  <img
    src={photoFile(photo, 1200)}
    srcset={srcset}
    sizes={sizes}
    alt={alt}
    width={photo.width}
    height={photo.height}
    loading="lazy"
    decoding="async"
    class:list={['h-full w-full object-cover', imgClass]}
  />
  {/* Brand tint — keeps photography cohesive with the gradient system in both themes */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-brand/15 via-transparent to-transparent"></div>
</figure>
