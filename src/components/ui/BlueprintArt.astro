---
/**
 * BlueprintArt — the isometric dark-blueprint SVG illustrations, keyed by
 * `kind`. Decorative (aria-hidden), micro-animations gated behind
 * prefers-reduced-motion. Render inside a <BlueprintFigure>.
 */
import type { BlueprintKind } from '@/data/blueprints';

interface Props {
  kind: BlueprintKind;
  class?: string;
}
const { kind, class: klass = 'mx-auto block h-full w-full max-w-[560px] p-8' } = Astro.props;
---

{
  kind === 'agentic' && (
    /* Agentic automation — stacked isometric planes, flowing connector */
    <svg viewBox="0 0 480 360" fill="none" aria-hidden="true" class={klass}>
      <g stroke="rgb(var(--brand))" stroke-width="1.5">
        <path d="M240 36 356 94 240 152 124 94Z" fill="rgb(var(--brand) / 0.10)" />
        <path d="M240 152v14M356 94v14M124 94v14" stroke-dasharray="3 4" opacity="0.7" />
        <path d="M240 84 296 112 240 140 184 112Z" fill="rgb(var(--accent) / 0.14)" stroke="rgb(var(--accent))" />
      </g>
      <g stroke="rgb(var(--brand))" stroke-width="1.5" opacity="0.85">
        <path d="M240 132 388 206 240 280 92 206Z" fill="rgb(var(--surface-2) / 0.9)" />
        <path d="M92 206v18l148 74v-18M388 206v18l-148 74v-18" fill="rgb(var(--surface-3) / 0.9)" />
      </g>
      <g class="bp-flow" stroke="rgb(var(--accent))" stroke-width="1.5" stroke-dasharray="6 6">
        <path d="M240 152v-12M240 132 148 178M240 132l92 46" />
      </g>
      <g stroke="rgb(var(--text-muted))" stroke-width="1.2" opacity="0.55">
        <path d="M170 206h60M170 220h90M170 234h44" />
        <rect x="268" y="200" width="70" height="38" rx="4" stroke="rgb(var(--accent))" />
        <path d="M278 212h50M278 222h34" />
      </g>
      <circle class="bp-pulse" cx="240" cy="112" r="4" fill="rgb(var(--accent))" />
      <circle class="bp-pulse" cx="303" cy="219" r="3" fill="rgb(var(--brand))" style="animation-delay: 1.1s" />
    </svg>
  )
}
{
  kind === 'document' && (
    /* Document intelligence — isometric sheet, scan sweep, confidence chip */
    <svg viewBox="0 0 480 360" fill="none" aria-hidden="true" class={klass}>
      <g stroke="rgb(var(--brand))" stroke-width="1.5">
        <path d="M240 52 400 132 240 212 80 132Z" fill="rgb(var(--surface-2) / 0.9)" />
        <path d="M80 132v16l160 80v-16M400 132v16l-160 80v-16" fill="rgb(var(--surface-3) / 0.9)" />
      </g>
      <g stroke="rgb(var(--text-muted))" stroke-width="1.2" opacity="0.6">
        <path d="M170 118h80M158 132h120M172 146h70M200 160h60" />
        <path d="M300 96l36 18" stroke="rgb(var(--accent))" />
      </g>
      <line class="bp-scan" x1="120" y1="132" x2="360" y2="132" stroke="rgb(var(--accent))" stroke-width="1.5" opacity="0.9" />
      <g class="bp-float">
        <circle cx="322" cy="196" r="34" stroke="rgb(var(--accent))" stroke-width="2" fill="rgb(var(--accent) / 0.08)" />
        <path d="M346 220l26 26" stroke="rgb(var(--accent))" stroke-width="3" stroke-linecap="round" />
        <path d="M308 192h28M308 202h18" stroke="rgb(var(--text))" stroke-width="1.5" opacity="0.8" />
      </g>
      <g class="bp-float" style="animation-delay: 1.6s">
        <rect x="96" y="228" width="118" height="30" rx="6" fill="rgb(var(--surface-3))" stroke="rgb(var(--brand))" stroke-width="1.2" />
        <circle cx="114" cy="243" r="4" fill="rgb(var(--success))" />
        <path d="M128 240h72M128 248h48" stroke="rgb(var(--text-muted))" stroke-width="1.5" />
      </g>
    </svg>
  )
}
{
  kind === 'sql' && (
    /* SQL dashboards — isometric plate with 3D bars + trend line */
    <svg viewBox="0 0 480 360" fill="none" aria-hidden="true" class={klass}>
      <g stroke="rgb(var(--brand))" stroke-width="1.5">
        <path d="M240 120 408 204 240 288 72 204Z" fill="rgb(var(--surface-2) / 0.9)" />
        <path d="M72 204v16l168 84v-16M408 204v16l-168 84v-16" fill="rgb(var(--surface-3) / 0.9)" />
      </g>
      {[
        { x: 168, y: 196, h: 54, c: 'brand' },
        { x: 216, y: 214, h: 86, c: 'accent' },
        { x: 264, y: 196, h: 64, c: 'brand' },
        { x: 312, y: 214, h: 110, c: 'accent' },
      ].map((b) => (
        <g stroke={`rgb(var(--${b.c}))`} stroke-width="1.4">
          <path d={`M${b.x} ${b.y}v-${b.h}l24 12v${b.h}Z`} fill={`rgb(var(--${b.c}) / 0.25)`} />
          <path d={`M${b.x} ${b.y - b.h}l12 -6 24 12 -12 6Z`} fill={`rgb(var(--${b.c}) / 0.45)`} />
        </g>
      ))}
      <path class="bp-draw" d="M150 180 C 200 130, 260 150, 300 110 S 380 80, 396 92" stroke="rgb(var(--accent))" stroke-width="2" stroke-linecap="round" />
      <circle class="bp-pulse" cx="396" cy="92" r="4" fill="rgb(var(--accent))" />
    </svg>
  )
}
{
  kind === 'mlops' && (
    /* MLOps — pipeline gauge with needle + stage nodes */
    <svg viewBox="0 0 480 360" fill="none" aria-hidden="true" class={klass}>
      <path d="M120 260a120 120 0 0 1 240 0" stroke="rgb(var(--border-strong))" stroke-width="26" stroke-linecap="round" opacity="0.5" />
      <path d="M120 260a120 120 0 0 1 240 0" stroke="url(#bp-gauge)" stroke-width="26" stroke-linecap="round" stroke-dasharray="260 380" />
      <defs>
        <linearGradient id="bp-gauge" x1="120" y1="260" x2="360" y2="260" gradientUnits="userSpaceOnUse">
          <stop stop-color="rgb(var(--brand))" />
          <stop offset="1" stop-color="rgb(var(--accent))" />
        </linearGradient>
      </defs>
      <g class="bp-needle" style="transform-origin: 240px 260px">
        <line x1="240" y1="260" x2="240" y2="172" stroke="rgb(var(--text))" stroke-width="2.5" stroke-linecap="round" />
        <circle cx="240" cy="260" r="6" fill="rgb(var(--text))" />
      </g>
      {[
        { cx: 132, cy: 244 },
        { cx: 176, cy: 176 },
        { cx: 240, cy: 148 },
        { cx: 304, cy: 176 },
        { cx: 348, cy: 244 },
      ].map((n, j) => (
        <circle class="bp-pulse" cx={n.cx} cy={n.cy} r="4.5" fill="rgb(var(--brand))" style={`animation-delay: ${j * 0.5}s`} />
      ))}
      <g stroke="rgb(var(--text-muted))" stroke-width="1.2" opacity="0.6">
        <rect x="176" y="288" width="128" height="30" rx="6" stroke="rgb(var(--accent))" />
        <path d="M192 300h96M192 308h64" />
      </g>
    </svg>
  )
}
{
  kind === 'vault' && (
    /* Security — isometric layered vault with glowing core and orbit ring */
    <svg viewBox="0 0 480 360" fill="none" aria-hidden="true" class={klass}>
      <g stroke="rgb(var(--brand))" stroke-width="1.5">
        <path d="M240 226 360 286 240 346 120 286Z" fill="rgb(var(--surface-3) / 0.9)" />
        <path d="M120 286v-16l120 60v16M360 286v-16l-120 60v16" fill="rgb(var(--surface-2) / 0.9)" opacity="0.9" />
      </g>
      <g stroke="rgb(var(--brand))" stroke-width="1.5" opacity="0.9">
        <path d="M240 150 340 200 240 250 140 200Z" fill="rgb(var(--brand) / 0.08)" />
        <path d="M140 200v34l100 50v-34M340 200v34l-100 50v-34" fill="rgb(var(--surface-2) / 0.85)" />
      </g>
      <g class="bp-float">
        <path d="M240 74 320 114 240 154 160 114Z" stroke="rgb(var(--accent))" stroke-width="1.5" fill="rgb(var(--accent) / 0.12)" />
        <path d="M240 96l26 13-26 13-26-13Z" fill="rgb(var(--accent) / 0.5)" stroke="rgb(var(--accent))" />
      </g>
      <path d="M240 154v-6M240 226v-6" stroke="rgb(var(--accent))" stroke-width="1.5" stroke-dasharray="3 4" />
      <circle class="bp-pulse" cx="240" cy="200" r="5" fill="rgb(var(--accent))" />
      <g class="bp-flow" stroke="rgb(var(--brand))" stroke-width="1.2" stroke-dasharray="5 6" opacity="0.8">
        <ellipse cx="240" cy="205" rx="150" ry="66" />
      </g>
      <circle class="bp-pulse" cx="96" cy="222" r="4" fill="rgb(var(--brand))" style="animation-delay: 0.7s" />
      <circle class="bp-pulse" cx="384" cy="188" r="4" fill="rgb(var(--brand))" style="animation-delay: 1.4s" />
    </svg>
  )
}

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    .bp-flow { animation: bp-dash 1.6s linear infinite; }
    .bp-scan { animation: bp-scan 3.4s ease-in-out infinite; }
    .bp-float { animation: bp-float 5s ease-in-out infinite; }
    .bp-pulse { animation: bp-pulse 2.2s ease-in-out infinite; }
    .bp-needle { animation: bp-needle 4.5s ease-in-out infinite; }
    .bp-draw {
      stroke-dasharray: 420;
      stroke-dashoffset: 420;
      animation: bp-draw 2.2s var(--ease-quint) forwards;
    }
  }
  @keyframes bp-dash { to { stroke-dashoffset: -24; } }
  @keyframes bp-scan {
    0%, 100% { transform: translateY(-34px); opacity: 0.25; }
    50% { transform: translateY(44px); opacity: 0.9; }
  }
  @keyframes bp-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-7px); }
  }
  @keyframes bp-pulse {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 1; }
  }
  @keyframes bp-needle {
    0%, 100% { transform: rotate(-32deg); }
    50% { transform: rotate(38deg); }
  }
  @keyframes bp-draw { to { stroke-dashoffset: 0; } }
</style>
