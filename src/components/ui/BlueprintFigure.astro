---
/**
 * BlueprintFigure — dark graph-paper panel with corner ticks and a vertical
 * ( FIG.0X ) plate label. Frame for BlueprintArt illustrations; decorative.
 */
interface Props {
  fig?: string;
  class?: string;
}
const { fig = '01', class: klass = '' } = Astro.props;
---

<div class:list={['bp-figure relative overflow-hidden rounded-2xl border border-line bg-bg/60', klass]}>
  <span
    class="absolute bottom-4 left-3 select-none font-mono text-[10px] tracking-[0.2em] text-ink-subtle [writing-mode:vertical-rl]"
    aria-hidden="true">( FIG.{fig} )</span
  >
  <span class="bp-tick bp-tick-tl" aria-hidden="true"></span>
  <span class="bp-tick bp-tick-tr" aria-hidden="true"></span>
  <span class="bp-tick bp-tick-bl" aria-hidden="true"></span>
  <span class="bp-tick bp-tick-br" aria-hidden="true"></span>
  <slot />
</div>

<style>
  .bp-figure {
    background-image:
      linear-gradient(rgb(var(--border) / 0.35) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--border) / 0.35) 1px, transparent 1px);
    background-size: 28px 28px;
  }
  .bp-tick {
    position: absolute;
    height: 5px;
    width: 5px;
    border-radius: 9999px;
    background: rgb(var(--text-subtle) / 0.6);
  }
  .bp-tick-tl { top: 10px; left: 10px; }
  .bp-tick-tr { top: 10px; right: 10px; }
  .bp-tick-bl { bottom: 10px; left: 10px; }
  .bp-tick-br { bottom: 10px; right: 10px; }
</style>
