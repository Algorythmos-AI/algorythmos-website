---
/**
 * SqlConsole — living port of service-sql-dashboards.svg (1120×760).
 * Signature: bars grow in on first view + KPI count-up; the loop is a gentle
 * dashboard refresh (~22s): "refreshing…" → "refreshed just now", the newest
 * bar nudges up and active accounts tick.
 */
import ConsoleShell from '@/components/ui/ConsoleShell.astro';
import { asLocale, useTranslations } from '@/i18n';
import { serviceVisuals } from '@/data/visuals';

const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);
const v = serviceVisuals['sql-dashboards'];

const kpis = [
  { label: t('console.svc.sql.k1'), value: '$4.82M', delta: '▲ 8.1%', up: true },
  { label: t('console.svc.sql.k2'), value: '1,946', delta: '▲ 124', up: true, count: 1946 },
  { label: t('console.svc.sql.k3'), value: '114%', delta: '▲ 2 pts', up: true },
  { label: t('console.svc.sql.k4'), value: '1.4%', delta: '▼ 0.3 pts', up: true },
];

/* bar heights out of 332px plot area (Sep..May) */
const bars = [180, 204, 162, 230, 252, 212, 278, 302, 332];
const months = ['Sep', 'Oct', 'Nov', 'Dec', 'Jan', 'Feb', 'Mar', 'Apr', 'May'];

const metrics = ['revenue', 'net_revenue_retention', 'gross_margin', 'active_accounts'];

const strings = {
  refreshing: t('console.svc.sql.refreshing'),
  refreshed: t('console.svc.sql.refreshedNow'),
};
---

<ConsoleShell svgFile={v.file} width={v.width} height={v.height} altKey={v.altKey} name="svc-sql-dashboards">
  <div class="hc sq">
    <script type="application/json" data-hc-strings set:html={JSON.stringify(strings)} />
    <div class="hc-chrome">
      <span class="hc-tdot"></span><span class="hc-tdot"></span><span class="hc-tdot"></span>
      <span class="hc-urlpill">app.algorythmos.com/dashboards</span>
    </div>

    <div class="sq-head">
      <div>
        <div class="sq-title">{t('console.svc.sql.title')}</div>
        <div class="sq-sub" data-hc-stage><span data-slot="refresh">{t('console.svc.sql.sub')}</span></div>
      </div>
      <span class="hc-livepill"><span class="hc-livedot"></span>{t('console.svc.sql.trusted')}</span>
    </div>

    <div class="sq-kpis">
      {kpis.map((k) => (
        <div class="hc-card sq-kpi">
          <span class="sq-kpi-label">{k.label}</span>
          <span class="sq-kpi-value" {...(k.count ? { 'data-hc-count': k.count, 'data-hc-format': 'int' } : {})}>{k.value}</span>
          <span class="sq-kpi-delta">{k.delta}</span>
        </div>
      ))}
    </div>

    <div class="sq-cols">
      {/* Bar chart */}
      <div class="hc-card sq-chart">
        <div class="hc-card-title">{t('console.svc.sql.monthly')}</div>
        <div class="hc-card-sub">{t('console.svc.sql.monthlySub')}</div>
        <div class="sq-plot">
          <span class="sq-grid" style="bottom: 270px"></span>
          <span class="sq-grid" style="bottom: 180px"></span>
          <span class="sq-grid" style="bottom: 90px"></span>
          {bars.map((h, i) => (
            <span class="sq-barcol" style={`--i: ${i}`}>
              <span class="sq-bar" data-bar={i} style={`height: ${h}px`}></span>
              <span class="sq-month">{months[i]}</span>
            </span>
          ))}
        </div>
      </div>

      <div class="sq-right">
        {/* Trend */}
        <div class="hc-card sq-trend">
          <div class="hc-card-title">{t('console.svc.sql.trend')}</div>
          <svg viewBox="0 0 312 90" class="sq-trend-svg" aria-hidden="true">
            <defs>
              <linearGradient id="sq-area" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#22d3ee" stop-opacity="0.3" />
                <stop offset="1" stop-color="#22d3ee" stop-opacity="0" />
              </linearGradient>
            </defs>
            <path class="hc-fill" d="M0 90 L0 70 L48 76 L96 56 L144 62 L192 36 L240 46 L288 18 L312 24 L312 90 Z" fill="url(#sq-area)" />
            <polyline class="hc-draw" pathLength="1" points="0,70 48,76 96,56 144,62 192,36 240,46 288,18 312,24" fill="none" stroke="#22d3ee" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            <circle class="hc-endpoint" cx="312" cy="24" r="3.5" fill="#22d3ee" />
          </svg>
        </div>
        {/* Governed metrics */}
        <div class="hc-card sq-metrics">
          <div class="hc-card-title">{t('console.svc.sql.governed')}</div>
          <ul class="sq-metriclist">
            {metrics.map((m, i) => (
              <li>
                <span class:list={['hc-dot', i === 3 ? 'hc-dot--accent' : 'hc-dot--brand']}></span>
                <code>{m}</code>
                <span class="sq-cert">{t('console.svc.sql.certified')}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</ConsoleShell>

<style>
  .sq { width: 1120px; height: 760px; }
  .sq-head { display: flex; align-items: flex-start; justify-content: space-between; padding: 24px 40px 0; }
  .sq-title { font-size: 18px; font-weight: 600; }
  .sq-sub { margin-top: 6px; font-size: 12.5px; color: var(--c-muted); }
  .sq-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; padding: 22px 40px 0; }
  .sq-kpi { background: var(--c-card-2); height: 98px; padding: 18px 22px; }
  .sq-kpi-label { display: block; font-size: 12px; color: var(--c-muted); }
  .sq-kpi-value { display: block; margin-top: 6px; font-size: 25px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .sq-kpi-delta { display: block; margin-top: 4px; font-size: 11px; color: var(--c-success); }
  .sq-cols { display: grid; grid-template-columns: 664px 1fr; gap: 16px; padding: 20px 40px 40px; flex: 1; min-height: 0; }
  .sq-chart { background: var(--c-card-2); padding: 24px; }
  .sq-plot { position: relative; display: flex; align-items: flex-end; gap: 24px; height: 332px; margin-top: 22px; padding: 0 16px; }
  .sq-grid { position: absolute; left: 0; right: 0; height: 1px; background: rgb(255 255 255 / 0.05); }
  .sq-barcol { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
  .sq-bar {
    display: block; width: 44px; border-radius: 4px 4px 0 0;
    background: linear-gradient(180deg, #a78bfa, #6366f1);
    transform-origin: bottom center;
  }
  .sq-month { position: absolute; top: calc(100% + 8px); font-size: 10.5px; color: var(--c-subtle); }
  .sq-right { display: flex; flex-direction: column; gap: 16px; }
  .sq-trend, .sq-metrics { background: var(--c-card-2); padding: 22px 24px; flex: 1; }
  .sq-trend-svg { display: block; width: 100%; height: 90px; margin-top: 16px; }
  .sq-metriclist { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-direction: column; gap: 18px; }
  .sq-metriclist li { display: flex; align-items: center; gap: 12px; font-size: 12px; }
  .sq-metriclist code { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 11.5px; color: var(--c-ink); }
  .hc-dot--brand { background: var(--c-brand); }
  .sq-cert { margin-left: auto; font-size: 11px; color: var(--c-subtle); }

  @media (prefers-reduced-motion: no-preference) {
    :global(.hc-armed) .sq-bar { transform: scaleY(0); }
    :global(.hc-armed.hc-live) .sq-bar {
      transform: scaleY(1);
      transition: transform 0.7s var(--ease-quint, ease-out) calc(var(--i, 0) * 70ms + 0.3s);
    }
    .sq-bar { transition: height 0.6s var(--ease-quint, ease-out); }
    :global(.sq-refreshing) .sq-bar[data-bar='8'] { animation: hc-row-flash 1.1s ease-out 1; }
  }
</style>

<script>
  import { initConsole, scheduleIdle } from '@/lib/consoleLoop';
  import type { ConsoleContext } from '@/lib/consoleLoop';

  function setup() {
    const root = document.querySelector<HTMLElement>('[data-console="svc-sql-dashboards"]');
    if (!root) return;
    initConsole(root, {
      loopMs: 22000,
      keyframes: [
        {
          // Scheduled refresh kicks off.
          t: 10000,
          apply: ({ root, strings }: ConsoleContext) => {
            const el = root.querySelector('[data-slot="refresh"]');
            if (el) el.textContent = strings['refreshing'];
            root.classList.add('sq-refreshing');
          },
        },
        {
          // Fresh numbers land: newest bar nudges up.
          t: 13000,
          apply: ({ root, strings }: ConsoleContext) => {
            const el = root.querySelector('[data-slot="refresh"]');
            if (el) el.textContent = strings['refreshed'];
            const bar = root.querySelector<HTMLElement>('[data-bar="8"]');
            if (bar) bar.style.height = '338px';
            root.classList.remove('sq-refreshing');
          },
        },
      ],
    });
  }
  const arm = () => scheduleIdle(setup);
  document.addEventListener('astro:page-load', arm);
  if (document.readyState !== 'loading') arm();
</script>
