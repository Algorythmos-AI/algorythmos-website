---
/**
 * LifecycleMap — the ML lifecycle as a band of linked stages on a platform base.
 * Pure HTML/CSS (no client JS); each stage links to the service that owns it.
 * Wraps into a two-column grid on phones.
 */
import { asLocale, useTranslations, localizePath } from '@/i18n';

const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);

const stages = [
  { id: 'data', slug: 'data-feature-management' },
  { id: 'features', slug: 'data-feature-management' },
  { id: 'train', slug: 'mlops-cicd' },
  { id: 'deploy', slug: 'mlops-cicd' },
  { id: 'serve', slug: 'mlops-cicd' },
  { id: 'monitor', slug: 'model-monitoring' },
  { id: 'retrain', slug: 'mlops-cicd' },
] as const;
---

<div class="lifecycle" data-lifecycle>
  <ol class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
    {stages.map((s, i) => (
      <li class="relative">
        <a
          href={localizePath(locale, `/services/${s.slug}`)}
          class="group flex h-full flex-col rounded-xl border border-line bg-surface-2/50 px-4 py-3 transition-colors duration-200 hover:border-brand/60"
        >
          <span class="font-mono text-[11px] tracking-[0.16em] text-brand" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="mt-1 text-sm font-semibold text-ink group-hover:text-brand">{t(`services.lifecycle.${s.id}`)}</span>
        </a>
      </li>
    ))}
  </ol>
  <a
    href={localizePath(locale, '/services/ai-platform-engineering')}
    class="mt-3 block rounded-xl border border-dashed border-line bg-bg/40 px-4 py-3 text-center text-sm text-ink-muted transition-colors duration-200 hover:border-brand/60 hover:text-ink"
  >
    {t('services.lifecycle.platform')}
  </a>
</div>
