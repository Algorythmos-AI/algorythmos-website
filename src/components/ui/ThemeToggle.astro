---
/**
 * Vanilla theme toggle — intentionally NOT a React island, so it never pulls
 * the React runtime onto pages. Event delegation + astro:after-swap make it
 * View-Transition safe. The no-flash init lives in BaseLayout.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-line text-ink-muted transition-colors duration-200 hover:border-brand hover:text-ink focus-visible:outline-none"
  aria-label="Toggle light or dark theme"
  title="Toggle theme"
>
  {/* Sun — shown in dark mode (click → light) */}
  <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  {/* Moon — shown in light mode (click → dark) */}
  <svg class="block h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  function syncToggle() {
    const btn = document.getElementById('theme-toggle');
    if (btn) btn.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'light'));
  }
  document.addEventListener('click', (e) => {
    const t = e.target as Element | null;
    const btn = t && t.closest ? t.closest('#theme-toggle') : null;
    if (!btn) return;
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    document.cookie = `theme=${next};path=/;max-age=31536000;samesite=lax`;
    syncToggle();
  });
  document.addEventListener('astro:after-swap', syncToggle);
  syncToggle();
</script>
