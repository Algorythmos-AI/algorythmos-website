---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomePage from '@/components/pages/HomePage.astro';
import { PREFIXED_LOCALES, asLocale, localeToRegion, useTranslations } from '@/i18n';
import { professionalService, imageObject } from '@/seo/schema';
import { heroVisual, photos, photoFile } from '@/data/visuals';

export function getStaticPaths() {
  return PREFIXED_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = asLocale(Astro.params.locale);
const region = localeToRegion(locale) as 'AU' | 'FR';
const t = useTranslations(locale);

const heroImg = imageObject({ path: heroVisual.file, alt: t(heroVisual.altKey), width: heroVisual.width, height: heroVisual.height, primary: true });
const bandImg = imageObject({
  path: photoFile(photos.teamCollaboration, 1600),
  alt: t(photos.teamCollaboration.altKey),
  width: photos.teamCollaboration.width,
  height: photos.teamCollaboration.height,
});
---

<BaseLayout title={t('home.meta.title')} description={t('home.meta.description')} path="/" jsonLd={[professionalService(region), heroImg, bandImg]}>
  <HomePage />
</BaseLayout>
