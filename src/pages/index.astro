---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomePage from '@/components/pages/HomePage.astro';
import { useTranslations } from '@/i18n';
import { imageObject } from '@/seo/schema';
import { heroVisual, photos, photoFile } from '@/data/visuals';

const t = useTranslations('en');
const heroImg = imageObject({
  path: heroVisual.file,
  alt: t(heroVisual.altKey),
  width: heroVisual.width,
  height: heroVisual.height,
  primary: true,
});
const bandImg = imageObject({
  path: photoFile(photos.teamCollaboration, 1600),
  alt: t(photos.teamCollaboration.altKey),
  width: photos.teamCollaboration.width,
  height: photos.teamCollaboration.height,
});
---

<BaseLayout
  title={t('home.meta.title')}
  description={t('home.meta.description')}
  path="/"
  jsonLd={[heroImg, bandImg]}
>
  <HomePage />
</BaseLayout>
