---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomePage from '@/components/pages/HomePage.astro';
import { useTranslations } from '@/i18n';
import { imageObject } from '@/seo/schema';
import { heroVisual } from '@/data/visuals';

const t = useTranslations('en');
const heroImg = imageObject({
  path: heroVisual.file,
  alt: t(heroVisual.altKey),
  width: heroVisual.width,
  height: heroVisual.height,
  primary: true,
});
---

<BaseLayout
  title="Algorythmos — AI consultancy for SMEs in Sydney & Paris"
  description="Boutique AI consultancy delivering agentic automation, document intelligence, SQL dashboards, and MLOps for SMEs across Australia and France."
  path="/"
  jsonLd={[heroImg]}
>
  <HomePage />
</BaseLayout>
