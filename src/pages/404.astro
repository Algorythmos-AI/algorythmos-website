---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Aurora from '@/components/ui/Aurora.astro';
import { useTranslations, localizePath } from '@/i18n';
import { ogImageUrl } from '@/seo/schema';

/**
 * Single static 404 (Vercel serves /404.html for every unknown path, in both
 * locale trees). Both languages are rendered; a tiny inline script shows the
 * French block when the missing URL was under /fr-fr. Links always target the
 * two locale homes — the unprefixed tree is not built.
 */
const blocks = (['au-en', 'fr-fr'] as const).map((loc) => ({ loc, t: useTranslations(loc) }));
const tEn = useTranslations('au-en');
---

<BaseLayout title={tEn('notFoundPage.meta.title')} description={tEn('notFoundPage.meta.description')} path="/404" noindex={true} image={ogImageUrl('/au-en')}>
  <section class="relative flex min-h-[70vh] items-center overflow-hidden border-b border-line">
    <Aurora class="opacity-60" />
    {blocks.map(({ loc, t }) => (
      <div class="container-page py-24 text-center" data-nf={loc} lang={loc === 'fr-fr' ? 'fr-FR' : 'en-AU'} hidden={loc === 'fr-fr'}>
        <p class="text-gradient-brand text-mega font-extrabold leading-none tracking-tight">{t('notFoundPage.errorCode')}</p>
        <h1 class="mt-4 text-h1 font-extrabold tracking-tight text-ink">{t('notFoundPage.title')}</h1>
        <p class="mx-auto mt-5 max-w-xl text-lead text-ink-muted">{t('notFoundPage.subtitle')}</p>
        <p class="mx-auto mt-3 max-w-lg text-ink-subtle">{t('notFoundPage.description')}</p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <Button href={localizePath(loc, '/')} size="lg">{t('notFoundPage.cta.home')}</Button>
          <Button href={localizePath(loc, '/services')} variant="secondary" size="lg">{t('nav.services')}</Button>
          <Button href={localizePath(loc, '/contact')} variant="secondary" size="lg">{t('notFoundPage.cta.contact')}</Button>
        </div>
      </div>
    ))}
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var fr = /^\/fr-fr(\/|$)/.test(location.pathname);
    var en = document.querySelector('[data-nf="au-en"]');
    var frb = document.querySelector('[data-nf="fr-fr"]');
    if (fr && en && frb) {
      en.hidden = true;
      frb.hidden = false;
      document.documentElement.lang = 'fr-FR';
    }
  })();
</script>
