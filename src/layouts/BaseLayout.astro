---
import '@fontsource-variable/inter';
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { asLocale, REGIONS, useTranslations } from '@/i18n';
import Header from '@/components/layout/Header.astro';
import AnnouncementBar from '@/components/layout/AnnouncementBar.astro';
import Footer from '@/components/layout/Footer.astro';
import SEO from '@/components/seo/SEO.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { orgGraph } from '@/seo/schema';
import RegionBanner from '@/components/RegionBanner.astro';
import ConsentBanner from '@/components/ConsentBanner.astro';

interface Props {
  title?: string;
  description?: string;
  /** region-relative canonical path, e.g. '/services' */
  path?: string;
  ogType?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  /** Single-locale page (local landing pages): self-canonical only, no cross-locale hreflang. */
  standalone?: boolean;
  /** extra per-page JSON-LD blocks (Service, Article, BreadcrumbList, …) */
  jsonLd?: (Record<string, unknown> | Record<string, unknown>[])[];
}

const {
  title = 'Algorythmos — AI Consultancy for SMEs',
  description = 'Boutique AI consultancy delivering agentic automation, document intelligence, and MLOps for SMEs in Sydney and Paris.',
  path = '/',
  ogType = 'website',
  image,
  noindex = false,
  standalone = false,
  jsonLd = [],
} = Astro.props;

const locale = asLocale(Astro.currentLocale);
const lang = REGIONS[locale].lang;
const t = useTranslations(locale);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Primary text face — preloaded so the first paint doesn't wait on CSS discovery (LCP) */}
    <link rel="preload" href={interLatinWoff2} as="font" type="font/woff2" crossorigin />

    {/* No-flash theme init — before paint */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          document.documentElement.dataset.theme = t;
          if (localStorage.getItem('motion') === 'off') document.documentElement.dataset.motion = 'off';
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    <script is:inline>
      /* Returning visitor with an explicit region choice → swap between the two locale
         HOMES only (never deeper pages, never for bots — they run no JS). */
      (function () {
        try {
          var p = location.pathname.replace(/\/$/, '');
          if (p !== '/au-en' && p !== '/fr-fr') return;
          var m = document.cookie.match(/(?:^|; )locale=(au-en|fr-fr)/);
          if (m && '/' + m[1] !== p) location.replace('/' + m[1]);
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      /* First-touch campaign attribution — session-scoped, first-party, no identifiers.
         Read back by the contact form so enquiries carry their source. */
      (function () {
        try {
          if (sessionStorage.getItem('alg-utm')) return;
          var q = new URLSearchParams(location.search);
          var parts = [];
          ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'].forEach(function (k) {
            var v = q.get(k);
            if (v) parts.push(k + '=' + v.slice(0, 60));
          });
          if (!parts.length && document.referrer) {
            var ref = new URL(document.referrer);
            if (ref.host !== location.host) parts.push('referrer=' + ref.host);
          }
          if (parts.length) sessionStorage.setItem('alg-utm', parts.join('&').slice(0, 300));
        } catch (e) {}
      })();
    </script>
    <SEO title={title} description={description} path={path} ogType={ogType} image={image} noindex={noindex} standalone={standalone} />
    <meta name="generator" content={Astro.generator} />
    <JsonLd data={orgGraph} />
    {jsonLd.map((d) => <JsonLd data={d} />)}
    {/* Blog feed — FR locale gets the French feed, everyone else the English one */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t('ui.rssFeed')}
      href={locale === 'fr-fr' ? '/fr-fr/rss.xml' : '/rss.xml'}
    />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />
    )}
    {import.meta.env.PUBLIC_BING_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_VERIFICATION} />
    )}
    {import.meta.env.PUBLIC_YANDEX_VERIFICATION && (
      <meta name="yandex-verification" content={import.meta.env.PUBLIC_YANDEX_VERIFICATION} />
    )}
    {/* No JS: hide the living-console canvas so each console's <noscript> SVG shows in its frame. */}
    <noscript><style is:inline>.hc-screen{display:none!important}</style></noscript>
    <ClientRouter />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only rounded-lg bg-brand px-4 py-2 font-semibold text-brand-fg focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[var(--z-toast)]"
    >
      {t('ui.skipToContent')}
    </a>
    <Header />
    <AnnouncementBar />
    <main id="main"><slot /></main>
    <Footer />
    <RegionBanner />
    <ConsentBanner />
    {/* Re-assert theme + motion after View-Transition swaps. The client router replaces
        every attribute on <html> with the incoming document's, so this mirrors the
        no-flash script in <head> exactly — including the OS fallback, or a light-mode
        visitor who never touched the toggle lands on dark after their first click. */}
    <script is:inline>
      document.addEventListener('astro:after-swap', function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          document.documentElement.dataset.theme = t;
          if (localStorage.getItem('motion') === 'off') document.documentElement.dataset.motion = 'off';
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      });
    </script>
    <script>
      /* JS-available marker — reveal styles only hide content under html.js.
         Set HERE, in the module that performs the reveal, so a failed or blocked
         module never leaves the page hidden (the inline scripts still run when a
         module 404s or is blocked by CSP). */
      const markJs = () => document.documentElement.classList.add('js');
      markJs();
      let stopReveal = () => {};
      function setupReveal() {
        /* Runs on astro:after-swap, on astro:page-load and once directly: only the
           first call for a page finds anything new, and a later one must not undo it. */
        const els = [...document.querySelectorAll<HTMLElement>('[data-reveal]:not([data-reveal-seen])')];
        const show = (e: Element) => e.classList.add('is-visible');
        if (!els.length) return;
        els.forEach((e) => (e.dataset.revealSeen = ''));
        if (!('IntersectionObserver' in window)) {
          els.forEach(show);
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((en) => {
              if (en.isIntersecting) {
                show(en.target);
                io.unobserve(en.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );
        /* Anything already inside the first viewport is shown synchronously — the
           opening screen must never wait on an observer callback. */
        const vh = window.innerHeight || document.documentElement.clientHeight;
        const below: Element[] = [];
        els.forEach((e) => {
          const r = e.getBoundingClientRect();
          if (r.top < vh && r.bottom > 0) show(e);
          else below.push(e);
        });
        /* Everything below the fold is shown too — until the visitor scrolls. A
           renderer that never scrolls (a crawler, a full-page screenshot) must find
           the whole page there. A visitor who does scroll gets the reveals: on the
           first sign of it, whatever is still out of sight is hidden again, unseen
           and without a transition, and then revealed as it arrives. (A timer used
           to reveal everything after 1.5 s, which meant that for anyone who read the
           first screen before scrolling, nothing below it ever animated in.) */
        below.forEach((e) => {
          e.classList.add('reveal-instant');
          show(e);
        });
        const listeners = new AbortController();
        const arm = () => {
          listeners.abort();
          const edge = (window.innerHeight || vh) * 1.05;
          below.forEach((e) => {
            if (e.getBoundingClientRect().top > edge) {
              e.classList.remove('is-visible');
              io.observe(e);
            }
          });
          /* Settle the hidden state while the transition is still switched off, or the
             last one hidden would fade out instead of vanishing. */
          void document.documentElement.offsetHeight;
          requestAnimationFrame(() => below.forEach((e) => e.classList.remove('reveal-instant')));
        };
        /* Only real scrolling arms the reveals. A modifier key (Cmd+P, a screenshot
           shortcut) is not scrolling, and neither is the router returning a new page
           to the top. */
        const SCROLL_KEYS = ['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', 'End', 'Home', ' '];
        const on = <K extends keyof WindowEventMap>(type: K, wants: (ev: WindowEventMap[K]) => boolean) =>
          window.addEventListener(
            type,
            (ev) => {
              if (wants(ev)) arm();
            },
            { passive: true, signal: listeners.signal },
          );
        on('wheel', () => true);
        on('touchmove', () => true);
        on('scroll', () => window.scrollY > 4);
        on('keydown', (ev) => !ev.metaKey && !ev.ctrlKey && !ev.altKey && SCROLL_KEYS.includes(ev.key));
        stopReveal = () => {
          listeners.abort();
          io.disconnect();
        };
      }
      /* A view-transition swap wipes <html>'s class along with its other attributes.
         Restore the marker before the new page paints, or reveals stop after the
         first in-site navigation — and reveal in the same breath: astro:page-load
         only fires once every script on the incoming page has loaded, and the
         opening screen must not sit hidden for that long. */
      document.addEventListener('astro:after-swap', () => {
        markJs();
        setupReveal();
      });
      document.addEventListener('astro:page-load', setupReveal);
      document.addEventListener('astro:before-swap', () => stopReveal());
      /* Initialize immediately if astro:page-load already fired before this module ran */
      if (document.readyState !== 'loading') setupReveal();

      /* Card spotlight: a soft light follows the cursor across a card (global.css
         `.ring-gradient::after`). One delegated listener for the whole visit, only
         where there is a cursor to follow. */
      if (window.matchMedia('(hover: hover)').matches) {
        let frame = 0;
        let last: PointerEvent | null = null;
        document.addEventListener(
          'pointermove',
          (event) => {
            last = event;
            if (frame) return;
            frame = requestAnimationFrame(() => {
              frame = 0;
              const card = last?.target instanceof Element ? last.target.closest<HTMLElement>('.ring-gradient') : null;
              if (!last || !card) return;
              const r = card.getBoundingClientRect();
              card.style.setProperty('--mx', `${last.clientX - r.left}px`);
              card.style.setProperty('--my', `${last.clientY - r.top}px`);
            });
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>
